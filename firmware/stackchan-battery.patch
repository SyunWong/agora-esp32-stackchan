+static void show_battery(stackchan_battery_notice_t notice, uint32_t now_ms)
+{
+    stackchan_battery_reading_t value = stackchan_battery_reading();
+    char percent[12];
+    if (value.valid) snprintf(percent, sizeof(percent), "~%d%%", value.percent);
+    else snprintf(percent, sizeof(percent), "--");
+    const char *detail = !value.valid ? "UNAVAILABLE" :
+                         notice == BATTERY_NOTICE_LOW ? "PLEASE CHARGE" :
+                         value.milliamps < -20 ? "CHARGING" : "BATTERY";
+    uint16_t ink = notice == BATTERY_NOTICE_LOW ? 0xfd20 : 0xffff;
+    if (!battery_visible) snprintf(deferred_label, sizeof(deferred_label), "%s", previous_label);
+    battery_visible = true;
+    battery_until = now_ms + 2000;
+    for (int top = 0; top < HEIGHT; top += STRIP_LINES) {
+        for (int row = 0; row < STRIP_LINES; ++row) {
+            int y = top + row;
+            for (int x = 0; x < WIDTH; ++x) {
+                bool outline = x >= 120 && x < 196 && y >= 65 && y < 101 &&
+                               (x < 123 || x >= 193 || y < 68 || y >= 98);
+                bool terminal = x >= 196 && x < 201 && y >= 77 && y < 89;
+                bool fill = value.valid && x >= 127 && x < 127 + value.percent * 62 / 100 && y >= 72 && y < 94;
+                uint16_t color = outline || terminal || fill ? ink : 0;
+                if (text_pixel(percent, 120, 4, x, y)) color = ink;
+                if (text_pixel(value.valid ? "ESTIMATE" : "UNKNOWN", 160, 1, x, y)) color = 0x8c71;
+                if (text_pixel(detail, 190, 2, x, y)) color = ink;
+                strip[row * WIDTH + x] = wire_color(color);
+            }
+        }
+        if (!submit_pixels(0, top, WIDTH, STRIP_LINES)) return;
+    }
+    ESP_LOGI(TAG, "Battery card kind=%d valid=%d estimate=%d duration_ms=2000",
+             notice, value.valid, value.valid ? value.percent : -1);
+}
+
+void stackchan_status_battery_start(uint32_t now_ms)
+{
+    if (!ready) return;
+    stackchan_battery_init(now_ms);
+    stackchan_status_tick(now_ms);
+}
+
 void stackchan_status_tick(uint32_t now_ms)
 {
     if (!ready || !scene_drawn) return;
+    stackchan_battery_notice_t notice = stackchan_battery_tick(now_ms);
+    if (notice != BATTERY_NOTICE_NONE) show_battery(notice, now_ms);
+    if (!ready) return;
+    if (battery_visible) {
+        if ((int32_t)(now_ms - battery_until) < 0) return;
+        battery_visible = false; scene_drawn = false; eyes_closed = false;
+        blink_started = false;
+        stackchan_status_show(deferred_label);
+        ESP_LOGI(TAG, "Battery card hidden; face restored");
+        if (!ready) return;
+    }
     if (!blink_started) {
         blink_started = true;
         next_blink_ms = now_ms + 5200;
