@@ -0,0 +1,17 @@
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+// Same application task as status_screen. Uses BoardManager's existing I2C bus.
+// No task, GPIO, power rail, charger, protection or automatic shutdown changes.
+typedef struct {
+    bool valid;
+    int millivolts;
+    int milliamps;
+    int percent; // Voltage estimate, rounded to 5%; not a fuel-gauge measurement.
+} stackchan_battery_reading_t;
+typedef enum { BATTERY_NOTICE_NONE, BATTERY_NOTICE_STARTUP,
+               BATTERY_NOTICE_LOW, BATTERY_NOTICE_POWER_KEY } stackchan_battery_notice_t;
+void stackchan_battery_init(uint32_t now_ms);
+stackchan_battery_notice_t stackchan_battery_tick(uint32_t now_ms);
+stackchan_battery_reading_t stackchan_battery_reading(void);
