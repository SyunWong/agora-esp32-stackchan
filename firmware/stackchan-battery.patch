diff --git a/solutions/agora_demo/main/stackchan_battery.c b/solutions/agora_demo/main/stackchan_battery.c
new file mode 100644
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_battery.c
@@ -0,0 +1,147 @@
+/* StackChan base battery monitor, register facts from M5Stack StackChan-BSP
+ * and M5Unified INA226/AXP2101 drivers (MIT). Original implementation here.
+ * INA226 0x41: 1.25mV/bus LSB, 2.5uV/shunt LSB, 10 milliohm resistor.
+ * Positive current = discharging. AXP2101 0x49 bit2 = long power-key event;
+ * acknowledge only that W1C bit, never other interrupts or power settings.
+ */
+#include "stackchan_battery.h"
+#include "driver/i2c_master.h"
+#include "esp_board_manager.h"
+#include "esp_log.h"
+#include <stddef.h>
+
+#define IO_MS 10
+#define SAMPLE_MS 5000U
+#define KEY_MS 250U
+#define REMIND_MS 300000U
+static const char *TAG = "STACKCHAN_BATTERY";
+static i2c_master_dev_handle_t monitor, pmic;
+static bool attempted, startup_pending, low_latched, reminded, key_armed;
+static uint32_t last_sample, last_key, last_reminder;
+static unsigned low_samples, recovered_samples;
+static stackchan_battery_reading_t reading;
+
+static bool read_bytes(i2c_master_dev_handle_t dev, uint8_t reg, uint8_t *data, size_t size)
+{
+    return dev && i2c_master_transmit_receive(dev, &reg, 1, data, size, IO_MS) == ESP_OK;
+}
+static bool read16(uint8_t reg, uint16_t *value)
+{
+    uint8_t data[2];
+    if (!read_bytes(monitor, reg, data, sizeof(data))) return false;
+    *value = (uint16_t)data[0] << 8 | data[1];
+    return true;
+}
+static bool ack_long_key(void)
+{
+    const uint8_t bytes[] = {0x49, 0x04};
+    return i2c_master_transmit(pmic, bytes, sizeof(bytes), IO_MS) == ESP_OK;
+}
+static int estimate(int mv)
+{
+    // Coarse single-cell voltage estimate. Loaded/charging voltage is not SOC.
+    static const int volts[] = {3300, 3500, 3600, 3700, 3750, 3800, 3850, 3900, 4000, 4100, 4200};
+    static const int levels[] = {0, 5, 10, 20, 30, 40, 50, 60, 75, 90, 100};
+    if (mv <= volts[0]) return 0;
+    for (unsigned i = 1; i < sizeof(volts)/sizeof(volts[0]); ++i) {
+        if (mv <= volts[i]) {
+            int p = levels[i-1] + (mv-volts[i-1])*(levels[i]-levels[i-1])/(volts[i]-volts[i-1]);
+            return ((p+2)/5)*5;
+        }
+    }
+    return 100;
+}
+static void sample(void)
+{
+    uint16_t bus, shunt, config;
+    reading.valid = read16(0x00, &config) && (config & 7) == 7 &&
+                    read16(0x02, &bus) && read16(0x01, &shunt);
+    if (reading.valid) {
+        int mv = (int)bus * 5 / 4;
+        int ma = (int)(int16_t)shunt / 4;
+        reading.valid = mv >= 2500 && mv <= 4400 && ma > -8000 && ma < 8000;
+        if (reading.valid) {
+            reading.millivolts = mv;
+            reading.milliamps = ma;
+            reading.percent = estimate(mv);
+        }
+    }
+    if (!reading.valid) {
+        reading.millivolts = 0; reading.milliamps = 0; reading.percent = -1;
+        low_samples = recovered_samples = 0;
+        return;
+    }
+    // Three samples reject a brief servo/speaker voltage sag; charging suppresses warnings.
+    if (reading.millivolts <= 3500 && reading.milliamps >= -20) {
+        recovered_samples = 0;
+        if (low_samples < 3) ++low_samples;
+        if (low_samples == 3) low_latched = true;
+    } else {
+        low_samples = 0;
+        if (reading.millivolts >= 3650 || reading.milliamps < -20) {
+            if (recovered_samples < 3) ++recovered_samples;
+            if (recovered_samples == 3) { low_latched = false; reminded = false; }
+        } else recovered_samples = 0;
+    }
+}
+void stackchan_battery_init(uint32_t now_ms)
+{
+    if (attempted) return;
+    attempted = true; startup_pending = true;
+    last_sample = last_key = now_ms;
+    i2c_master_bus_handle_t bus = NULL;
+    if (esp_board_manager_get_periph_handle("i2c_master", (void **)&bus) != ESP_OK || !bus) return;
+    i2c_device_config_t config = {.dev_addr_length=I2C_ADDR_BIT_LEN_7,
+                                .device_address=0x41, .scl_speed_hz=400000};
+    if (i2c_master_bus_add_device(bus, &config, &monitor) == ESP_OK) {
+        uint16_t id, manufacturer;
+        if (!read16(0xff, &id) || id != 0x2260 || !read16(0xfe, &manufacturer) || manufacturer != 0x5449) {
+            i2c_master_bus_rm_device(monitor); monitor = NULL;
+        }
+    }
+    config.device_address = 0x34;
+    if (i2c_master_bus_add_device(bus, &config, &pmic) == ESP_OK) {
+        uint8_t id, flags;
+        if (!read_bytes(pmic, 0x03, &id, 1) || id != 0x4a ||
+            !read_bytes(pmic, 0x49, &flags, 1)) {
+            i2c_master_bus_rm_device(pmic); pmic = NULL;
+        } else {
+            // Discard a stale startup long-press rather than displaying shutdown.
+            key_armed = !(flags & 4) || ack_long_key();
+        }
+    }
+    sample();
+    ESP_LOGI(TAG, "Monitor=%d key=%d valid=%d battery_mv=%d current_ma=%d estimate=%d",
+             monitor != NULL, pmic != NULL, reading.valid, reading.millivolts,
+             reading.milliamps, reading.percent);
+}
+stackchan_battery_reading_t stackchan_battery_reading(void) { return reading; }
+stackchan_battery_notice_t stackchan_battery_tick(uint32_t now_ms)
+{
+    if (!attempted) return BATTERY_NOTICE_NONE;
+    if (startup_pending) { startup_pending = false; return BATTERY_NOTICE_STARTUP; }
+    if ((uint32_t)(now_ms-last_sample) >= SAMPLE_MS) { last_sample = now_ms; sample(); }
+    if (pmic && (uint32_t)(now_ms-last_key) >= KEY_MS) {
+        last_key = now_ms;
+        uint8_t flags;
+        if (read_bytes(pmic, 0x49, &flags, 1)) {
+            bool was_armed = key_armed;
+            if (!(flags & 4)) key_armed = true;
+            else {
+                key_armed = ack_long_key();
+                if (was_armed && key_armed) {
+                    sample(); last_sample = now_ms;
+                    ESP_LOGI(TAG, "Power-key battery preview; hardware power-off unchanged");
+                    return BATTERY_NOTICE_POWER_KEY;
+                }
+            }
+        }
+    }
+    if (reading.valid && low_latched && reading.milliamps >= -20 &&
+        (!reminded || (uint32_t)(now_ms-last_reminder) >= REMIND_MS)) {
+        reminded = true; last_reminder = now_ms;
+        ESP_LOGW(TAG, "Low battery reminder battery_mv=%d estimate=%d", reading.millivolts, reading.percent);
+        return BATTERY_NOTICE_LOW;
+    }
+    return BATTERY_NOTICE_NONE;
+}
