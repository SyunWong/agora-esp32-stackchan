+typedef enum { IDLE, AI_STARTING, AI_ACTIVE, RING_STARTING, RINGING,
+               ACCEPTING, HUMAN_CONNECTING, HUMAN_ACTIVE, RESUMING,
+               STOPPING, FAILED } phase_t;
+typedef enum { COMMAND_NONE, COMMAND_START, COMMAND_STOP, COMMAND_ACCEPT,
+               COMMAND_END, COMMAND_SHUTDOWN } command_t;
+typedef enum { MEDIA_NONE, MEDIA_AI, MEDIA_HUMAN } media_t;
+typedef enum { CALL_NONE, CALL_RINGING, CALL_ACCEPTING, CALL_CONNECTING,
+               CALL_ACTIVE, CALL_ENDED } call_state_t;
+
+static const char *TAG = "STACKCHAN_CALL";
+static atomic_int phase;
+static atomic_uint generation;
+static atomic_bool shutting_down;
+static atomic_bool quiescent = true;
+static portMUX_TYPE state_lock = portMUX_INITIALIZER_UNLOCKED;
+static command_t pending_command;
