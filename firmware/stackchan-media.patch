+// Called only after a successful codec write. Aggregate levels only: no audio
+// recording. Fixed output below is signed stereo 32-bit, measured on a 16-bit scale.
+static int playback_meter(uint8_t *data, int size, void *ctx)
+{
+    static bool registers_logged;
+    if (!registers_logged) {
+        const int regs[] = {0x01, 0x04, 0x05, 0x06, 0x0c};
+        for (int i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+            int value = -1;
+            int ret = esp_codec_dev_read_reg((esp_codec_dev_handle_t)ctx, regs[i], &value);
+            ESP_LOGI(TAG, "DAC_REG %02x=%04x ret=%d", regs[i], value, ret);
+        }
+        registers_logged = true;
+    }
+    static uint64_t energy;
+    static uint32_t samples, peak, blocks;
+    const int32_t *pcm = (const int32_t *)data;
+    for (int i = 0; i < size / (int)sizeof(int32_t); ++i) {
+        int32_t v = pcm[i] / 65536;
+        uint32_t magnitude = v < 0 ? -v : v;
+        if (magnitude > peak) peak = magnitude;
+        energy += (int64_t)v * v;
+        ++samples;
+    }
