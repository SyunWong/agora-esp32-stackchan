@@ -42,8 +43,48 @@ typedef struct {
     void                        *ctx;
     uint8_t                     *frame_data;
     int                          frame_size;
+    uint64_t                     meter_energy;
+    uint32_t                     meter_samples;
+    uint32_t                     meter_frames;
+    uint32_t                     meter_blocks;
+    uint32_t                     meter_peak;
 } adec_t;
 
+// Numeric diagnostics before resampling; no PCM is retained. Inspect every
+// eighth time sample, including all channels, to bound the extra CPU work.
+static void meter_decoded_frame(adec_t *adec, const av_render_audio_frame_t *frame)
+{
+    const av_render_audio_frame_info_t *info = &adec->frame_info;
+    if (!frame->data || !info->sample_rate || !info->channel ||
+        (info->bits_per_sample != 16 && info->bits_per_sample != 32)) {
+        return;
+    }
+    uint32_t count = frame->size / (info->channel * (info->bits_per_sample / 8));
+    for (uint32_t i = 0; i < count; i += 8) {
+        for (unsigned ch = 0; ch < info->channel; ++ch) {
+            uint32_t index = i * info->channel + ch;
+            int32_t value = info->bits_per_sample == 16
+                                ? ((const int16_t *)frame->data)[index]
+                                : ((const int32_t *)frame->data)[index] / 65536;
+            uint32_t magnitude = value < 0 ? -value : value;
+            if (magnitude > adec->meter_peak) adec->meter_peak = magnitude;
+            adec->meter_energy += (int64_t)value * value;
+            ++adec->meter_samples;
+        }
+    }
+    adec->meter_frames += count;
+    ++adec->meter_blocks;
+    if (adec->meter_frames >= info->sample_rate * 2 && adec->meter_samples) {
+        ESP_LOGI(TAG, "DECODED_PCM blocks=%" PRIu32 " rms16=%u sampled_peak16=%" PRIu32
+                 " sampled_values=%" PRIu32 " stride=8",
+                 adec->meter_blocks,
+                 (unsigned)sqrt((double)adec->meter_energy / adec->meter_samples),
+                 adec->meter_peak, adec->meter_samples);
+        adec->meter_energy = 0;
+        adec->meter_samples = adec->meter_frames = adec->meter_blocks = adec->meter_peak = 0;
+    }
+}
+
