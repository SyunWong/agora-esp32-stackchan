+static void raw_input_meter(void)
+{
+    if (!raw_meter_enabled) return;
+    // This scratch buffer lives on the existing AUD_SRC PSRAM stack. The mirror
+    // returns the same packed 16-bit M,R pairs as the AEC input after layout
+    // conversion. Read a bounded subset; never delay capture waiting for data.
+    int16_t scratch[256];
+    int bytes_read = 0;
+    int ret = esp_codec_dev_mirror_read(meter_record, (uint8_t *)scratch,
+                                      sizeof(scratch), 0, &bytes_read);
+    if (ret == ESP_CODEC_DEV_TIMEOUT) ++raw_meter.timeouts;
+    else if (ret != ESP_CODEC_DEV_OK) ++raw_meter.errors;
+    if (bytes_read < 0 || bytes_read > (int)sizeof(scratch) || bytes_read % 4 != 0) {
+        raw_meter_enabled = false;
+        ESP_LOGW(TAG, "Raw input meter disabled: unaligned mirror result");
+        return;
+    }
+    for (int i = 0; i < bytes_read / (int)sizeof(*scratch); i += 2) {
+        int32_t mic = scratch[i], ref = scratch[i + 1];
+        uint32_t mic_abs = mic < 0 ? -mic : mic;
+        uint32_t ref_abs = ref < 0 ? -ref : ref;
+        if (mic_abs > raw_meter.mic_peak) raw_meter.mic_peak = mic_abs;
+        if (ref_abs > raw_meter.ref_peak) raw_meter.ref_peak = ref_abs;
+        raw_meter.mic_energy += (int64_t)mic * mic;
+        raw_meter.ref_energy += (int64_t)ref * ref;
+        raw_meter.mic_sum += mic;
+        raw_meter.ref_sum += ref;
+        raw_meter.cross += (int64_t)mic * ref;
+        ++raw_meter.pairs;
+    }
+    int64_t now = esp_timer_get_time();
+    if (now - raw_meter.started_us < 2000000) return;
+    uint32_t n = raw_meter.pairs;
+    unsigned mic_rms = n ? (unsigned)sqrt((double)raw_meter.mic_energy / n) : 0;
+    unsigned ref_rms = n ? (unsigned)sqrt((double)raw_meter.ref_energy / n) : 0;
+    int correlation = 0, correlation_valid = 0;
+    if (n) {
+        double mic_variance = raw_meter.mic_energy - (double)raw_meter.mic_sum * raw_meter.mic_sum / n;
+        double ref_variance = raw_meter.ref_energy - (double)raw_meter.ref_sum * raw_meter.ref_sum / n;
+        if (mic_variance > 0 && ref_variance > 0) {
+            double covariance = raw_meter.cross - (double)raw_meter.mic_sum * raw_meter.ref_sum / n;
+            correlation = (int)(1000 * covariance / sqrt(mic_variance * ref_variance));
+            correlation_valid = 1;
+        }
+    }
