+++ b/solutions/agora_demo/main/stackchan_afe.c
@@ -0,0 +1,52 @@
+#include <string.h>
+#include <stdatomic.h>
+#include "stackchan_afe.h"
+#include "esp_afe_config.h"
+#include "esp_log.h"
+
+static atomic_bool human_call;
+
+void stackchan_afe_set_human_call(bool enabled)
+{
+    atomic_store(&human_call, enabled);
+}
+
+// ESP Capture 1.1.2 creates an SR profile internally and exposes no AFE config
+// callback. The interactive target wraps only that exact MR/low-cost request;
+// all other callers retain the SDK behavior. No managed component is patched.
+afe_config_t *__real_afe_config_init(const char *input_format,
+                                   srmodel_list_t *models,
+                                   afe_type_t type, afe_mode_t mode);
+
+afe_config_t *__wrap_afe_config_init(const char *input_format,
+                                   srmodel_list_t *models,
+                                   afe_type_t type, afe_mode_t mode)
+{
+    bool voice_profile = atomic_load(&human_call) && input_format && strcmp(input_format, "MR") == 0 &&
+                         type == AFE_TYPE_SR && mode == AFE_MODE_LOW_COST;
+    afe_config_t *cfg = __real_afe_config_init(input_format, models,
+                                             voice_profile ? AFE_TYPE_FD : type, mode);
+    if (!cfg || !voice_profile) return cfg;
+
+    cfg->aec_init = true;
+    // Full-duplex uses the proven SR FFT canceller plus residual suppression,
+    // avoiding the VOIP FIR/resampler path that overloaded this device.
+    cfg->aec_mode = AEC_MODE_FD_LOW_COST;
+    cfg->aec_nlp_level = AEC_NLP_LEVEL_AGGR;
+    cfg->ns_init = true;
+    // This SDK treats every non-NULL name as an external NSNet model name.
+    // NULL selects its built-in WebRTC suppressor; the header's "WEBRTC"
+    // string hint does not match the installed implementation.
+    cfg->ns_model_name = NULL;
+    cfg->afe_ns_mode = AFE_NS_MODE_WEBRTC;
+    cfg->agc_init = false;
+    cfg->vad_init = false;
+    cfg->wakenet_init = false;
+    cfg->se_init = false;
+
+    // Keep the SDK's filter length, linear gain, task placement and allocations.
+    // Fetch remains continuous; silence gating would impair a two-way call.
+    ESP_LOGI("STACKCHAN_AFE", "FD low-cost MR; NLP=AGGR NS=WEBRTC; AGC/VAD/WakeNet/SE=off; filter=%d linear_gain_x100=%d",
+             cfg->aec_filter_length, (int)(cfg->afe_linear_gain * 100));
+    return cfg;
+}
