diff --git a/solutions/agora_demo/cmake/stackchan_capture_cache.cmake b/solutions/agora_demo/cmake/stackchan_capture_cache.cmake
new file mode 100644
index 0000000..605e342
--- /dev/null
+++ b/solutions/agora_demo/cmake/stackchan_capture_cache.cmake
@@ -0,0 +1,60 @@
+# Keep the vendor checkout unchanged. ESP Capture 1.1.2 assumes AFE feed and
+# fetch chunks have equal sizes; voice-call AEC can feed 160 and fetch 512.
+function(stackchan_replace_once variable before after)
+    set(value "${${variable}}")
+    string(FIND "${value}" "${before}" first)
+    if(first LESS 0)
+        message(FATAL_ERROR "StackChan capture patch: expected source fragment missing")
+    endif()
+    string(LENGTH "${before}" fragment_length)
+    math(EXPR tail_start "${first} + ${fragment_length}")
+    string(SUBSTRING "${value}" ${tail_start} -1 tail)
+    string(FIND "${tail}" "${before}" duplicate)
+    if(NOT duplicate LESS 0)
+        message(FATAL_ERROR "StackChan capture patch: source fragment is not unique")
+    endif()
+    string(REPLACE "${before}" "${after}" value "${value}")
+    set(${variable} "${value}" PARENT_SCOPE)
+endfunction()
+
+function(stackchan_prepare_capture_source source output)
+    file(READ "${source}" code)
+    stackchan_replace_once(code
+        "    int                         cache_size;\n"
+        "    int                         cache_size; // AFE feed bytes, also used by ADC/VAD input\n    int                         fetch_cache_size; // Independent mono output capacity\n")
+    stackchan_replace_once(code
+        "    src->cache_size = audio_chunksize * (16 / 8);\n"
+        "    src->cache_size = audio_chunksize * (16 / 8);\n    int fetch_chunksize = src->afe_handle->get_fetch_chunksize(src->afe_data);\n    src->fetch_cache_size = (fetch_chunksize > audio_chunksize ? fetch_chunksize : audio_chunksize) * (16 / 8);\n    ESP_LOGI(TAG, \"AFE buffers feed=%d fetch=%d output_bytes=%d\", audio_chunksize, fetch_chunksize, src->fetch_cache_size);\n")
+    stackchan_replace_once(code
+        "    src->cached_frame = capture_calloc(1, src->cache_size);\n"
+        "    src->cached_frame = capture_calloc(1, src->fetch_cache_size);\n")
+    stackchan_replace_once(code
+        "            if (res->data_size <= src->cache_size) {\n"
+        "            if (res->data_size <= src->fetch_cache_size) {\n")
+    file(WRITE "${output}" "${code}")
+endfunction()
+
+function(stackchan_apply_capture_cache_fix)
+    idf_component_get_property(capture_dir espressif__esp_capture COMPONENT_DIR)
+    idf_component_get_property(capture_target espressif__esp_capture COMPONENT_LIB)
+    set(original "${capture_dir}/impl/capture_audio_src/capture_audio_aec_src.c")
+    set(patched "${CMAKE_CURRENT_BINARY_DIR}/stackchan_capture_audio_aec_src.c")
+    get_target_property(sources ${capture_target} SOURCES)
+    set(replaced 0)
+    set(replacement_sources "")
+    foreach(source IN LISTS sources)
+        if(source STREQUAL original OR source STREQUAL "impl/capture_audio_src/capture_audio_aec_src.c")
+            math(EXPR replaced "${replaced} + 1")
+            list(APPEND replacement_sources "${patched}")
+        else()
+            list(APPEND replacement_sources "${source}")
+        endif()
+    endforeach()
+    if(NOT replaced EQUAL 1)
+        message(FATAL_ERROR "StackChan capture patch: expected exactly one original target source, found ${replaced}")
+    endif()
+    stackchan_prepare_capture_source("${original}" "${patched}")
+    set_property(TARGET ${capture_target} PROPERTY SOURCES "${replacement_sources}")
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
+    message(STATUS "StackChan: separate AFE feed/fetch cache in generated capture source")
+endfunction()
