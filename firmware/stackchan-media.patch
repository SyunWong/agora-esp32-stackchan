diff --git a/solutions/agora_demo/main/stackchan_motion.c b/solutions/agora_demo/main/stackchan_motion.c
new file mode 100644
index 0000000..e18c3ca
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_motion.c
@@ -0,0 +1,395 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Adapted protocol/power details: Copyright (c) 2021 M5Stack,
+ * Copyright (c) 2026 M5Stack Technology CO LTD, Copyright (c) 2024 ftservo.
+ * See LICENSE.motion for the retained upstream license notices.
+ *
+ * Optional, bounded head motion for the existing StackChan. Protocol/pins:
+ * https://docs.m5stack.com/en/StackChan/
+ * M5Stack StackChan-BSP M5StackChan.cpp (UART1/6/7, PY32 VM_EN), and the
+ * previously validated whale_motion.cpp / SCS.cpp whole-frame UART fix.
+ * Only the existing calibrated position mode is accepted; never write EEPROM.
+ */
+#include "stackchan_motion.h"
+#include <stdatomic.h>
+
+#ifndef CONFIG_STACKCHAN_HEAD_MOTION
+esp_err_t stackchan_motion_init(void) { return ESP_OK; }
+void stackchan_motion_request(stackchan_motion_pose_t pose) { (void)pose; }
+bool stackchan_motion_settled(void) { return true; }
+#else
+#include "stackchan_motion_math.h"
+#include <string.h>
+#include "driver/i2c_master.h"
+#include "driver/uart.h"
+#include "esp_board_manager.h"
+#include "esp_heap_caps.h"
+#include "esp_io_expander.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "nvs.h"
+#include "nvs_flash.h"
+
+#define MOTION_UART UART_NUM_1
+#define IO_MS 100
+#define STACK_BYTES 4096
+#define POSE_TIMEOUT_US 20000000LL
+static const char *TAG = "STACKCHAN_MOTION";
+// Low two bits are pose, upper bits revision. Identical requests are idempotent.
+static atomic_uint desired = STACKCHAN_MOTION_HOLD;
+static atomic_uint completed = UINT32_MAX;
+static atomic_bool available;
+static i2c_master_dev_handle_t py32;
+static bool uart_ready, uart_installed, attempted;
+static int zero[2];
+static StaticTask_t worker_tcb;
+
+void stackchan_motion_request(stackchan_motion_pose_t pose)
+{
+    if ((unsigned)pose > STACKCHAN_MOTION_OFF) return;
+    unsigned old = atomic_load(&desired);
+    while ((old & 3u) != (unsigned)pose && (old & 3u) != STACKCHAN_MOTION_OFF) {
+        unsigned next = ((old + 4u) & ~3u) | (unsigned)pose;
+        if (atomic_compare_exchange_weak(&desired, &old, next)) return;
+    }
+}
+
+bool stackchan_motion_settled(void)
+{
+    return !atomic_load(&available) || atomic_load(&desired) == atomic_load(&completed);
+}
+
+static bool read_reg(i2c_master_dev_handle_t dev, uint8_t reg, uint8_t *value, size_t size)
+{
+    return i2c_master_transmit_receive(dev, &reg, 1, value, size, IO_MS) == ESP_OK;
+}
+
+static bool py_bit(uint8_t reg, bool on)
+{
+    uint8_t bytes[2] = {reg, 0};
+    if (!read_reg(py32, reg, &bytes[1], 1)) return false;
+    bytes[1] = on ? bytes[1] | 1u : bytes[1] & ~1u;
+    if (i2c_master_transmit(py32, bytes, 2, IO_MS) != ESP_OK) return false;
+    uint8_t verify;
+    return read_reg(py32, reg, &verify, 1) && verify == bytes[1];
+}
+
+static bool servo_transaction(uint8_t id, uint8_t instruction, uint8_t reg,
+                              const uint8_t *data, size_t size, uint8_t *out, size_t count)
+{
+    uint8_t frame[13], response[21] = {0};
+    size_t length = motion_packet(frame, id, instruction, reg, data, size);
+    if (!uart_ready || !length || count > 15) {
+        ESP_LOGE(TAG, "Servo local rejection id=%u op=%u reg=%u count=%u ready=%d",
+                 id, instruction, reg, (unsigned)count, uart_ready);
+        return false;
+    }
+    esp_err_t flushed = uart_flush_input(MOTION_UART);
+    int written = flushed == ESP_OK ? uart_write_bytes(MOTION_UART, frame, length) : -1;
+    esp_err_t drained = written == (int)length ? uart_wait_tx_done(MOTION_UART, pdMS_TO_TICKS(IO_MS)) : ESP_FAIL;
+    if (flushed != ESP_OK || written != (int)length || drained != ESP_OK) {
+        ESP_LOGE(TAG, "Servo TX failed id=%u op=%u reg=%u count=%u flush=%d written=%d frame=%u drain=%d",
+                 id, instruction, reg, (unsigned)count, flushed, written, (unsigned)length, drained);
+        return false;
+    }
+    // At the production 100 Hz tick rate, pdMS_TO_TICKS(5) is zero. Always
+    // yield while waiting, without extending the absolute response deadline.
+    const TickType_t wait_ticks = pdMS_TO_TICKS(5) ? pdMS_TO_TICKS(5) : 1;
+    const int64_t tick_us = 1000000LL / configTICK_RATE_HZ;
+    int64_t started = esp_timer_get_time(), end = started + IO_MS * 1000LL;
+    size_t received = 0;
+    while (received < count + 6) {
+        int64_t remaining = end - esp_timer_get_time();
+        // Do not start another blocking wait if less than one tick remains.
+        if (remaining < tick_us) break;
+        TickType_t ticks = (TickType_t)(remaining / tick_us);
+        if (ticks > wait_ticks) ticks = wait_ticks;
+        uint8_t byte;
+        if (uart_read_bytes(MOTION_UART, &byte, 1, ticks) != 1) continue;
+        if (received < 2 && byte != 0xff) { received = 0; continue; }
+        response[received++] = byte;
+    }
+    // A higher-priority task may have delayed us while this same response was
+    // already queued. Take only one bounded snapshot; never wait or resend the
+    // request after its deadline. A late reply cannot be mistaken for a retry.
+    size_t buffered = 0, supplemented = 0;
+    if (received < count + 6 && uart_get_buffered_data_len(MOTION_UART, &buffered) == ESP_OK) {
+        size_t budget = count + 6 - received;
+        if (budget > buffered) budget = buffered;
+        while (supplemented < budget && received < count + 6) {
+            uint8_t byte;
+            if (uart_read_bytes(MOTION_UART, &byte, 1, 0) != 1) break;
+            ++supplemented;
+            if (received < 2 && byte != 0xff) { received = 0; continue; }
+            response[received++] = byte;
+        }
+    }
+    if (!motion_response(response, received, id, count)) {
+        // Numeric motor protocol only. Startup retries are bounded; steady-state
+        // failure disables motion, so this cannot log on every healthy 100ms tick.
+        unsigned wire_sum = 0;
+        for (size_t i = 2; i < received; ++i) wire_sum += response[i];
+        ESP_LOGE(TAG, "Servo RX rejected id=%u op=%u reg=%u count=%u got=%u expected=%u status_received=%u status=%u first=%02x,%02x,%02x,%02x,%02x,%02x tail=%02x sum=%02x elapsed_ms=%lld buffered=%u supplemented=%u",
+                 id, instruction, reg, (unsigned)count, (unsigned)received, (unsigned)(count + 6),
+                 received >= 5, response[4], response[0], response[1], response[2], response[3], response[4], response[5],
+                 received ? response[received-1] : 0, wire_sum & 255u,
+                 (long long)((esp_timer_get_time() - started) / 1000), (unsigned)buffered, (unsigned)supplemented);
+        return false;
+    }
+    if (supplemented) ESP_LOGI(TAG, "Servo RX buffered completion id=%u op=%u reg=%u count=%u elapsed_ms=%lld buffered=%u supplemented=%u",
+                              id, instruction, reg, (unsigned)count,
+                              (long long)((esp_timer_get_time() - started) / 1000), (unsigned)buffered, (unsigned)supplemented);
+    if (count) memcpy(out, response + 5, count);
+    return true;
+}
+
+static bool servo_read(uint8_t id, uint8_t reg, uint8_t *out, uint8_t count)
+{
+    return servo_transaction(id, 2, reg, &count, 1, out, count);
+}
+
+static bool servo_torque(uint8_t id, bool on)
+{
+    uint8_t value = on;
+    return servo_transaction(id, 3, 40, &value, 1, NULL, 0);
+}
+
+static bool servo_position(uint8_t id, int position)
+{
+    if (position < 0 || position > 1000) return false;
+    uint8_t data[] = {(uint8_t)(position >> 8), (uint8_t)position, 0, 100, 0, 40};
+    return servo_transaction(id, 3, 42, data, 6, NULL, 0);
+}
+
+static void release_motion(void)
+{
+    // Stop further targets before bounded best-effort torque/power shutdown.
+    atomic_store(&available, false);
+    if (uart_ready) { (void)servo_torque(1, false); (void)servo_torque(2, false); }
+    if (py32) {
+        bool off = false;
+        for (int i = 0; i < 3 && !off; ++i) off = py_bit(0x05, false);
+        if (off) ESP_LOGI(TAG, "Motor power shutdown confirmed vm_en=0");
+        else ESP_LOGE(TAG, "VM_EN shutdown could not be confirmed");
+    }
+    // Never disable global BUS/BOOST rails: shared audio/display remain powered.
+}
+
+static bool configure_external_power(i2c_master_bus_handle_t bus)
+{
+    esp_io_expander_handle_t *owner = NULL;
+    if (esp_board_manager_get_device_handle("gpio_expander", (void **)&owner) != ESP_OK ||
+        !owner || !*owner) return false;
+    uint32_t outputs;
+    if ((*owner)->read_output_reg(*owner, &outputs) != ESP_OK) return false;
+    i2c_master_dev_handle_t axp = NULL;
+    const i2c_device_config_t cfg = {.dev_addr_length = I2C_ADDR_BIT_LEN_7,
+                                    .device_address = 0x34, .scl_speed_hz = 400000};
+    if (i2c_master_bus_add_device(bus, &cfg, &axp) != ESP_OK) return false;
+    uint8_t status, ts[2];
+    bool safe = read_reg(axp, 0x00, &status, 1);
+    int raw = -1;
+    if (safe && !(status & 0x08) && (status & 0x20) && !(outputs & (1u << 1))) {
+        safe = read_reg(axp, 0x36, ts, 2);
+        if (safe) raw = ((ts[0] & 0x3f) << 8) | ts[1];
+    }
+    safe = safe && motion_supply_safe(status, outputs, raw);
+    (void)i2c_master_bus_rm_device(axp);
+    if (!safe) return false;
+    // Startup only, while no concurrent BoardManager consumer changes outputs.
+    // Use the existing driver so its cached latch/direction remain consistent.
+    // Enable BOOST first, then BUS_OUT; all unrelated bits are preserved.
+    return esp_io_expander_set_dir(*owner, (1u << 15) | (1u << 1), IO_EXPANDER_OUTPUT) == ESP_OK &&
+           esp_io_expander_set_level(*owner, 1u << 15, 1) == ESP_OK &&
+           esp_io_expander_set_level(*owner, 1u << 1, 1) == ESP_OK;
+}
+
+static bool feedback(uint8_t id, int *position, bool *moving)
+{
+    uint8_t data[15];
+    if (!servo_read(id, 56, data, sizeof(data))) return false;
+    *position = motion_word(data);
+    *moving = data[10] != 0;
+    bool valid = *position <= 1000 && data[7] <= 60 && motion_abs(motion_load(data + 4)) <= 650;
+    if (!valid) ESP_LOGE(TAG, "Servo feedback rejected id=%u position=%d temperature=%u load=%d moving=%u",
+                        id, *position, data[7], motion_load(data + 4), data[10]);
+    return valid;
+}
+
+static void motion_worker(void *unused)
+{
+    (void)unused;
+    int position[2], commanded[2], previous[2], stalls[2] = {0};
+    bool moving[2];
+    const char *stage = "startup_wait";
+    unsigned fault_id = 0;
+    // The existing physical servos required 1.5 s after VM_EN, not 200 ms.
+    for (int i = 0; i < 30; ++i) {
+        if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF) goto done;
+        vTaskDelay(pdMS_TO_TICKS(50));
+    }
+    for (int axis = 0; axis < 2; ++axis) {
+        uint8_t id = axis + 1, limits[4], model[2];
+        fault_id = id; stage = "torque_off";
+        if (!servo_torque(id, false)) goto fault;
+        stage = "startup_feedback";
+        bool got = false;
+        for (int retry = 0; retry < 5 && !got; ++retry) {
+            if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF) goto done;
+            got = feedback(id, &position[axis], &moving[axis]);
+            if (!got) vTaskDelay(pdMS_TO_TICKS(100));
+        }
+        if (!got) goto fault;
+        stage = "model";
+        if (!servo_read(id, 3, model, sizeof(model))) goto fault;
+        ESP_LOGI(TAG, "Servo startup id=%u model=%d position=%d", id, motion_word(model), position[axis]);
+        if (motion_word(model) != 1284) goto fault;
+        stage = "limits";
+        if (!servo_read(id, 9, limits, sizeof(limits))) goto fault;
+        ESP_LOGI(TAG, "Servo startup limits id=%u min=%d max=%d zero=%d", id,
+                 motion_word(limits), motion_word(limits+2), zero[axis]);
+        if (!motion_start_valid(axis, position[axis], zero[axis], motion_word(limits), motion_word(limits+2))) goto fault;
+        commanded[axis] = previous[axis] = position[axis];
+    }
+    for (int axis = 0; axis < 2; ++axis) {
+        if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF) goto done;
+        fault_id = axis + 1; stage = "seed_position";
+        if (!servo_position(axis + 1, position[axis])) goto fault;
+        if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF) goto done;
+        stage = "torque_enable";
+        if (!servo_torque(axis + 1, true)) goto fault;
+    }
+    unsigned ticket = UINT32_MAX;
+    unsigned quiet = 0;
+    int target = commanded[1];
+    int64_t deadline = 0;
+    for (;;) {
+        // Every path (including canceled I/O) yields before another slew step.
+        vTaskDelay(pdMS_TO_TICKS(100));
+        unsigned next_ticket = atomic_load(&desired);
+        stackchan_motion_pose_t pose = next_ticket & 3u;
+        if (pose == STACKCHAN_MOTION_OFF) goto done;
+        for (int axis = 0; axis < 2; ++axis) {
+            fault_id = axis + 1; stage = "active_feedback";
+            if (!feedback(axis + 1, &position[axis], &moving[axis])) goto fault;
+            if (motion_abs(commanded[axis] - position[axis]) > 15 &&
+                motion_abs(position[axis] - previous[axis]) <= 1) ++stalls[axis];
+            else stalls[axis] = 0;
+            previous[axis] = position[axis];
+            if (stalls[axis] >= 10) {
+                stage = "stall";
+                ESP_LOGE(TAG, "Servo stalled id=%u command=%d position=%d samples=%d",
+                         fault_id, commanded[axis], position[axis], stalls[axis]);
+                goto fault;
+            }
+        }
+        if (next_ticket != ticket) {
+            ticket = next_ticket; quiet = 0;
+            target = pose == STACKCHAN_MOTION_REST ? zero[1] + 16 :
+                     pose == STACKCHAN_MOTION_ATTENTIVE ? zero[1] + 48 : commanded[1];
+            deadline = esp_timer_get_time() + POSE_TIMEOUT_US;
+        }
+        // New/canceled requests invalidate work after any blocking I/O.
+        if (atomic_load(&desired) != ticket) continue;
+        int step = motion_step(commanded[1], target);
+        if (step != commanded[1]) {
+            // Feedback may finish after task preemption. Never send another
+            // target once the existing pose deadline has already expired.
+            if (esp_timer_get_time() >= deadline) {
+                fault_id = 2; stage = "pose_timeout";
+                ESP_LOGE(TAG, "Servo pose timeout id=2 target=%d command=%d position=%d moving=%d",
+                         target, commanded[1], position[1], moving[1]);
+                goto fault;
+            }
+            fault_id = 2; stage = "slew_position";
+            if (!servo_position(2, step)) goto fault;
+            commanded[1] = step;
+        }
+        if (atomic_load(&desired) != ticket) continue;
+        if (commanded[1] == target && motion_abs(position[1] - target) <= 3 && !moving[1]) {
+            if (quiet < 2) ++quiet;
+            if (quiet >= 2 && atomic_load(&completed) != ticket) {
+                atomic_store(&completed, ticket);
+                ESP_LOGI(TAG, "Motion settled pose=%u servo=2 target=%d position=%d",
+                         (unsigned)pose, target, position[1]);
+            }
+        } else quiet = 0;
+        if (atomic_load(&completed) != ticket && esp_timer_get_time() >= deadline) {
+            fault_id = 2; stage = "pose_timeout";
+            ESP_LOGE(TAG, "Servo pose timeout id=2 target=%d command=%d position=%d moving=%d",
+                     target, commanded[1], position[1], moving[1]);
+            goto fault;
+        }
+    }
+fault:
+    ESP_LOGE(TAG, "Motion disabled: stage=%s servo=%u", stage, fault_id);
+done:
+    if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF)
+        ESP_LOGI(TAG, "Motion disabled: requested OFF");
+    release_motion();
+    // Static PSRAM task stack/TCB remain allocated; never forcibly delete a task
+    // while it owns UART/I2C. Disabled motion cannot be rearmed by a call.
+    vTaskSuspend(NULL);
+}
+
+esp_err_t stackchan_motion_init(void)
+{
+    if (attempted) return ESP_ERR_INVALID_STATE;
+    attempted = true;
+    esp_err_t err = nvs_flash_init(); // Never erase/reformat on an init error.
+    if (err != ESP_OK) return err;
+    nvs_handle_t calibration;
+    if (nvs_open("servo", NVS_READONLY, &calibration) != ESP_OK) return ESP_ERR_INVALID_STATE;
+    int32_t yaw = -1, pitch = -1;
+    bool valid = nvs_get_i32(calibration, "zero_pos_1", &yaw) == ESP_OK &&
+                 nvs_get_i32(calibration, "zero_pos_2", &pitch) == ESP_OK;
+    nvs_close(calibration);
+    if (!valid || !motion_calibration_valid(yaw, pitch)) return ESP_ERR_INVALID_STATE;
+    zero[0] = yaw; zero[1] = pitch;
+    i2c_master_bus_handle_t bus = NULL;
+    if (esp_board_manager_get_periph_handle("i2c_master", (void **)&bus) != ESP_OK || !bus) return ESP_ERR_INVALID_STATE;
+    const i2c_device_config_t cfg = {.dev_addr_length = I2C_ADDR_BIT_LEN_7,
+                                    .device_address = 0x6f, .scl_speed_hz = 100000};
+    err = i2c_master_bus_add_device(bus, &cfg, &py32);
+    if (err != ESP_OK) return err;
+    uint8_t version = 0;
+    bool found = false;
+    for (int i = 0; i < 6 && !found; ++i) {
+        found = read_reg(py32, 0x02, &version, 1) && version != 0 && version != 0xff;
+        if (!found) vTaskDelay(pdMS_TO_TICKS(200));
+    }
+    if (!found) goto fail;
+    // VM_EN is held off while configuring its pin and the shared external rail.
+    if (!py_bit(0x05, false) || !py_bit(0x13, false) || !py_bit(0x03, true) ||
+        !py_bit(0x0b, false) || !py_bit(0x09, true) || !configure_external_power(bus)) goto fail;
+    const uart_config_t uart_cfg = {.baud_rate = 1000000, .data_bits = UART_DATA_8_BITS,
+        .parity = UART_PARITY_DISABLE, .stop_bits = UART_STOP_BITS_1,
+        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE, .source_clk = UART_SCLK_DEFAULT};
+    // Reserve UART1 without disturbing an existing owner.
+    if (uart_driver_install(MOTION_UART, 256, 256, 0, NULL, 0) != ESP_OK) goto fail;
+    uart_installed = true;
+    if (uart_param_config(MOTION_UART, &uart_cfg) != ESP_OK ||
+        uart_set_pin(MOTION_UART, 6, 7, UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE) != ESP_OK ||
+        uart_set_rx_full_threshold(MOTION_UART, 1) != ESP_OK ||
+        uart_set_rx_timeout(MOTION_UART, 2) != ESP_OK) goto fail;
+    uart_ready = true;
+    StackType_t *stack = heap_caps_malloc(STACK_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!stack) goto fail;
+    if ((atomic_load(&desired) & 3u) == STACKCHAN_MOTION_OFF || !py_bit(0x05, true)) {
+        heap_caps_free(stack); goto fail;
+    }
+    atomic_store(&available, true);
+    if (!xTaskCreateStaticPinnedToCore(motion_worker, "HEAD_MOTION", STACK_BYTES, NULL, 1, stack, &worker_tcb, 0)) {
+        heap_caps_free(stack); goto fail;
+    }
+    ESP_LOGI(TAG, "Optional head motion initialized; calibrated limits, no EEPROM writes");
+    return ESP_OK;
+fail:
+    release_motion();
+    if (uart_installed) { uart_driver_delete(MOTION_UART); uart_ready = uart_installed = false; }
+    if (py32) { i2c_master_bus_rm_device(py32); py32 = NULL; }
+    return ESP_FAIL;
+}
+#endif
diff --git a/solutions/agora_demo/main/stackchan_motion.h b/solutions/agora_demo/main/stackchan_motion.h
new file mode 100644
index 0000000..daf2f40
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_motion.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <stdbool.h>
+#include "esp_err.h"
+
+typedef enum {
+    STACKCHAN_MOTION_REST, STACKCHAN_MOTION_ATTENTIVE,
+    STACKCHAN_MOTION_HOLD, STACKCHAN_MOTION_OFF
+} stackchan_motion_pose_t;
+
+// Call once during serialized board startup, after display and before touch.
+// No NVS/servo EEPROM writes. OFF and faults disable motion until reboot.
+esp_err_t stackchan_motion_init(void);
+// Atomics only: safe from the interaction phase's short critical section.
+void stackchan_motion_request(stackchan_motion_pose_t pose);
+// Disabled/faulted motion is settled so it never blocks a voice call.
+bool stackchan_motion_settled(void);
diff --git a/solutions/agora_demo/main/stackchan_motion_math.h b/solutions/agora_demo/main/stackchan_motion_math.h
new file mode 100644
index 0000000..9e1c2f1
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_motion_math.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT
+ * Protocol/power adaptation notices: see LICENSE.motion. */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+static inline int motion_abs(int n) { return n < 0 ? -n : n; }
+static inline int motion_word(const uint8_t *p) { return ((int)p[0] << 8) | p[1]; }
+static inline int motion_load(const uint8_t *p)
+{
+    int n = motion_word(p);
+    return n & 1024 ? -(n & ~1024) : n;
+}
+static inline int motion_step(int current, int target)
+{
+    int delta = target - current;
+    return current + (delta > 2 ? 2 : delta < -2 ? -2 : delta);
+}
+static inline bool motion_calibration_valid(int yaw, int pitch)
+{
+    return yaw >= 100 && yaw <= 850 && pitch >= 100 && pitch <= 850;
+}
+static inline bool motion_start_valid(int axis, int position, int zero, int lo, int hi)
+{
+    // SCSCL stores a 10-bit EEPROM envelope (0..1023). Our commands/current
+    // positions keep the narrower 0..1000 software guard; factory max=1003 is
+    // confirmed on this robot and must not be rewritten or rejected outright.
+    if (lo < 0 || hi <= lo || hi > 1023 || position < lo || position > hi) return false;
+    if (axis == 0) return position >= 0 && position <= 1000;
+    return position >= zero && position <= zero + 272 && position <= 1000 &&
+           zero + 16 >= lo && zero + 48 <= hi;
+}
+// SCSCL: high byte first, checksum covers ID through final payload byte.
+static inline size_t motion_packet(uint8_t *out, uint8_t id, uint8_t instruction,
+                                   uint8_t reg, const uint8_t *data, size_t count)
+{
+    if (id < 1 || id > 2 || !data || count == 0 || count > 6) return 0;
+    out[0] = out[1] = 0xff; out[2] = id; out[3] = (uint8_t)(count + 3);
+    out[4] = instruction; out[5] = reg;
+    unsigned sum = id + out[3] + instruction + reg;
+    for (size_t i = 0; i < count; ++i) { out[6+i] = data[i]; sum += data[i]; }
+    out[6+count] = (uint8_t)~sum;
+    return count + 7;
+}
+static inline bool motion_response(const uint8_t *p, size_t size, uint8_t id, size_t count)
+{
+    if (count > 15 || size != count + 6 || p[0] != 0xff || p[1] != 0xff ||
+        p[2] != id || p[3] != count + 2 || p[4] != 0) return false;
+    unsigned sum = 0;
+    for (size_t i = 2; i < size; ++i) sum += p[i];
+    return (sum & 255) == 255;
+}
+// Matches the original M5Unified CoreS3 external-power safety guard.
+static inline bool motion_supply_safe(uint8_t axp_status, uint32_t outputs, int ts_raw)
+{
+    if ((axp_status & 0x08) || !(axp_status & 0x20) || (outputs & (1u << 1))) return true;
+    return ts_raw >= 0 && ts_raw < 0x3fff - 32 && ts_raw <= 4000;
+}
diff --git a/solutions/agora_demo/main/stackchan_tls_diagnostics.c b/solutions/agora_demo/main/stackchan_tls_diagnostics.c
new file mode 100644
index 0000000..e5eebcb
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_tls_diagnostics.c
@@ -0,0 +1,183 @@
+// Opt-in metadata observer for the vendored ESP-IDF mbedTLS debug API.
+// Never invoke the raw callback or log strings, pointers, records, certificates,
+// session identifiers or keys supplied by mbedTLS.
+#include "sdkconfig.h"
+#include "stackchan_tls_diagnostics.h"
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdatomic.h>
+#include <string.h>
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "mbedtls/debug.h"
+#include "mbedtls/ssl.h"
+
+#if !defined(CONFIG_STACKCHAN_TLS_HANDSHAKE_DIAGNOSTICS) || !defined(CONFIG_MBEDTLS_DEBUG) || CONFIG_MBEDTLS_DEBUG_LEVEL != 2
+#error "Handshake diagnostics require opt-in and mbedTLS debug level exactly 2"
+#endif
+
+static const char *TAG = "STACKCHAN_TLS";
+static struct {
+    unsigned request, phases, phase, tx_bytes, rx_bytes, tx_calls, rx_calls;
+    unsigned in_left, want;
+    int last_send, last_recv;
+    int64_t started, first_rx_ms;
+} trace;
+static _Atomic(TaskHandle_t) trace_owner;
+
+static void add_saturated(unsigned *value, unsigned add)
+{
+    *value = UINT_MAX - *value < add ? UINT_MAX : *value + add;
+}
+
+// debug.c bounds its line to 512 bytes, then may prepend "%p: ".
+static const char *message_body(const char *str)
+{
+    if (!str) return NULL;
+    size_t n = 0;
+    while (n < 532 && str[n]) ++n;
+    if (!n || n == 532 || str[n - 1] != '\n') return NULL;
+    if (n > 2 && str[0] == '0' && str[1] == 'x') {
+        size_t i = 2;
+        while (i < n && ((str[i] >= '0' && str[i] <= '9') ||
+               (str[i] >= 'a' && str[i] <= 'f') || (str[i] >= 'A' && str[i] <= 'F'))) ++i;
+        if (i == 2 || i > 18 || i + 2 >= n || str[i] != ':' || str[i + 1] != ' ') return NULL;
+        return str + i + 2;
+    }
+    return str;
+}
+
+static bool decimal(const char **p, unsigned *value)
+{
+    const char *s = *p;
+    if (*s < '0' || *s > '9') return false;
+    unsigned n = 0;
+    do {
+        unsigned d = (unsigned)(*s - '0');
+        if (n > (UINT_MAX - d) / 10) return false;
+        n = n * 10 + d;
+        ++s;
+    } while (*s >= '0' && *s <= '9');
+    *p = s; *value = n;
+    return true;
+}
+
+static bool returned(const char *body, const char *prefix, int *result)
+{
+    size_t n = strlen(prefix);
+    if (strncmp(body, prefix, n)) return false;
+    const char *p = body + n;
+    bool negative = *p == '-';
+    if (negative) ++p;
+    unsigned magnitude;
+    if (!decimal(&p, &magnitude) || magnitude > (negative ? (unsigned)INT_MAX + 1U : (unsigned)INT_MAX)) return false;
+    if (strncmp(p, " (-0x", 5)) return false;
+    p += 5;
+    unsigned hex = 0, digits = 0;
+    while ((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f')) {
+        if (++digits > 8) return false;
+        hex = hex * 16U + (unsigned)(*p <= '9' ? *p - '0' : *p - 'a' + 10);
+        ++p;
+    }
+    if (!digits || strcmp(p, ")\n")) return false;
+    int ret = negative ? (magnitude == (unsigned)INT_MAX + 1U ? INT_MIN : -(int)magnitude) : (int)magnitude;
+    if (hex != 0U - (unsigned)ret) return false;
+    *result = ret;
+    return true;
+}
+
+static void filtered_debug(void *ctx, int level, const char *file, int line, const char *str)
+{
+    (void)ctx; (void)file; (void)line;
+    TaskHandle_t owner = atomic_load(&trace_owner);
+    if (level != 2 || !owner || xTaskGetCurrentTaskHandle() != owner) return;
+    const char *body = message_body(str);
+    if (!body || (trace.phases & (1U << 15))) return;
+    // Local IDs are independent of private mbedTLS enums. SERVER_HELLO follows
+    // ClientHello flush to the BIO, which is not proof of remote delivery.
+    static const char *const states[] = {
+        "client state: MBEDTLS_SSL_CLIENT_HELLO\n",
+        "client state: MBEDTLS_SSL_SERVER_HELLO\n",
+        "client state: MBEDTLS_SSL_SERVER_CERTIFICATE\n",
+        "client state: MBEDTLS_SSL_SERVER_KEY_EXCHANGE\n",
+        "client state: MBEDTLS_SSL_CERTIFICATE_REQUEST\n",
+        "client state: MBEDTLS_SSL_SERVER_HELLO_DONE\n",
+        "client state: MBEDTLS_SSL_CLIENT_CERTIFICATE\n",
+        "client state: MBEDTLS_SSL_CLIENT_KEY_EXCHANGE\n",
+        "client state: MBEDTLS_SSL_CERTIFICATE_VERIFY\n",
+        "client state: MBEDTLS_SSL_CLIENT_CHANGE_CIPHER_SPEC\n",
+        "client state: MBEDTLS_SSL_CLIENT_FINISHED\n",
+        "client state: MBEDTLS_SSL_SERVER_CHANGE_CIPHER_SPEC\n",
+        "client state: MBEDTLS_SSL_SERVER_FINISHED\n",
+        "client state: MBEDTLS_SSL_FLUSH_BUFFERS\n",
+        "client state: MBEDTLS_SSL_HANDSHAKE_WRAPUP\n",
+        "handshake: done\n",
+    };
+    for (unsigned i = 0; i < sizeof(states) / sizeof(states[0]); ++i) {
+        if (strcmp(body, states[i])) continue;
+        trace.phase = i + 1;
+        unsigned bit = 1U << i;
+        if (!(trace.phases & bit)) {
+            trace.phases |= bit;
+            ESP_LOGI(TAG, "TLS phase req=%u phase=%u ms=%lld tx=%u rx=%u",
+                     trace.request, trace.phase, (long long)((esp_timer_get_time() - trace.started) / 1000),
+                     trace.tx_bytes, trace.rx_bytes);
+        }
+        return;
+    }
+    // No application I/O or warm HTTP metadata after handshake completion.
+    if (!trace.phase || (trace.phases & (1U << 15))) return;
+    int ret;
+    if (returned(body, "ssl->f_send() returned ", &ret)) {
+        trace.last_send = ret;
+        add_saturated(&trace.tx_calls, 1);
+        if (ret > 0) add_saturated(&trace.tx_bytes, (unsigned)ret);
+    } else if (returned(body, "ssl->f_recv(_timeout)() returned ", &ret)) {
+        trace.last_recv = ret;
+        add_saturated(&trace.rx_calls, 1);
+        if (ret > 0) {
+            if (trace.first_rx_ms < 0) trace.first_rx_ms = (esp_timer_get_time() - trace.started) / 1000;
+            add_saturated(&trace.rx_bytes, (unsigned)ret);
+        }
+    } else if (!strncmp(body, "in_left: ", 9)) {
+        const char *p = body + 9;
+        unsigned left, want;
+        if (!decimal(&p, &left) || strncmp(p, ", nb_want: ", 11)) return;
+        p += 11;
+        if (!decimal(&p, &want) || strcmp(p, "\n")) return;
+        trace.in_left = left; trace.want = want;
+    }
+}
+
+void __wrap_mbedtls_esp_enable_debug_log(mbedtls_ssl_config *conf, int threshold)
+{
+    (void)threshold;
+    // Never invoke Espressif's raw callback. Fixed level excludes secret dumps
+    // even if another caller requests a larger threshold.
+    mbedtls_debug_set_threshold(2);
+    mbedtls_ssl_conf_dbg(conf, filtered_debug, NULL);
+}
+
+void stackchan_tls_diagnostics_begin(unsigned request)
+{
+    memset(&trace, 0, sizeof(trace));
+    trace.request = request;
+    trace.started = esp_timer_get_time();
+    trace.first_rx_ms = -1;
+    atomic_store(&trace_owner, xTaskGetCurrentTaskHandle());
+}
+
+void stackchan_tls_diagnostics_end(void)
+{
+    atomic_store(&trace_owner, NULL);
+    if (!trace.phases) return; // A reused connection may not handshake.
+    // mbedTLS suppresses WANT_READ return logs: these are observed returns,
+    // not a count of every BIO call. Positive byte returns are not suppressed.
+    ESP_LOGI(TAG, "TLS summary req=%u phase=%u mask=%u tx=%u rx=%u send_returns=%u recv_returns=%u sendret=%d recvret=%d first_rx_ms=%lld in_left=%u want=%u",
+             trace.request, trace.phase, trace.phases, trace.tx_bytes, trace.rx_bytes,
+             trace.tx_calls, trace.rx_calls, trace.last_send, trace.last_recv,
+             (long long)trace.first_rx_ms, trace.in_left, trace.want);
+}
