diff --git a/solutions/agora_demo/main/task_diagnostics.c b/solutions/agora_demo/main/task_diagnostics.c
new file mode 100644
index 0000000..f820b99
--- /dev/null
+++ b/solutions/agora_demo/main/task_diagnostics.c
@@ -0,0 +1,87 @@
+#include "task_diagnostics.h"
+#include "sdkconfig.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#if defined(CONFIG_STACKCHAN_MEDIA_DIAGNOSTICS) && configUSE_TRACE_FACILITY && configGENERATE_RUN_TIME_STATS
+#include <stdbool.h>
+#include <stdint.h>
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+
+static const char *TAG = "TASK_DIAG";
+static const char *const names[] = {
+    "aenc_0", "buffer_in", "AUD_SRC", "Adec", "ARender", "pc_task", "pc_send", "AI_CONTROL",
+};
+#define TASK_COUNT (sizeof(names) / sizeof(names[0]))
+
+typedef struct {
+    TaskStatus_t status;
+    TaskHandle_t handle;
+    UBaseType_t number;
+    configRUN_TIME_COUNTER_TYPE runtime;
+    int64_t observed_us;
+    uint32_t stack_free_bytes;
+    bool seen;
+} observation_t;
+
+void stackchan_task_diagnostics(void)
+{
+    static observation_t *observations;
+    static bool unavailable;
+    if (unavailable) return;
+    if (!observations) {
+        observations = heap_caps_calloc(TASK_COUNT, sizeof(*observations),
+                                       MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!observations) {
+            unavailable = true;
+            ESP_LOGW(TAG, "Task diagnostics unavailable: no external scratch memory");
+            return;
+        }
+        ESP_LOGI(TAG, "CPU scale: 1000 permille=one core; dual-core sum may reach 2000; stack sampled once per task");
+    }
+    for (unsigned i = 0; i < TASK_COUNT; ++i) {
+        observation_t *previous = &observations[i];
+        TaskHandle_t handle = xTaskGetHandle(names[i]);
+        if (!handle) {
+            previous->seen = false;
+            ESP_LOGI(TAG, "TASK name=%s present=0", names[i]);
+            continue;
+        }
+        // Avoid uxTaskGetSystemState: that API scans every stack under the
+        // kernel lock. This query does not scan, and the separate one-time
+        // watermark scan below is preemptible in the low-priority caller.
+        vTaskGetInfo(handle, &previous->status, pdFALSE, eInvalid);
+        int64_t now = esp_timer_get_time();
+        TaskStatus_t *status = &previous->status;
+        bool same = previous->seen && previous->handle == handle &&
+                    previous->number == status->xTaskNumber;
+        int cpu_permille = -1; // First observation or a recreated task: baseline only.
+#ifdef CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER
+        if (same && now > previous->observed_us) {
+            configRUN_TIME_COUNTER_TYPE used = status->ulRunTimeCounter - previous->runtime;
+            cpu_permille = (int)((uint64_t)used * 1000 / (uint64_t)(now - previous->observed_us));
+        }
+#endif
+        if (!same) {
+            previous->stack_free_bytes =
+                (uint32_t)uxTaskGetStackHighWaterMark(handle) * sizeof(StackType_t);
+        }
+        int core = -1;
+#if configTASKLIST_INCLUDE_COREID
+        core = status->xCoreID;
+#endif
+        ESP_LOGI(TAG, "TASK name=%s cpu_one_core_permille=%d priority=%u core=%d stack_free_bytes_once=%lu",
+                 names[i], cpu_permille, (unsigned)status->uxCurrentPriority, core,
+                 (unsigned long)previous->stack_free_bytes);
+        previous->handle = handle;
+        previous->number = status->xTaskNumber;
+        previous->runtime = status->ulRunTimeCounter;
+        previous->observed_us = now;
+        previous->seen = true;
+    }
+}
+#else
+void stackchan_task_diagnostics(void) {}
+#endif
diff --git a/solutions/agora_demo/main/task_diagnostics.h b/solutions/agora_demo/main/task_diagnostics.h
