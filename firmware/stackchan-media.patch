+#pragma once
+
+// Optional numeric-only diagnostics. Call from the single media lifecycle owner
+// approximately every five seconds while connected, outside start/stop handling.
+// Never call concurrently with task teardown. The selected tasks' stack margins
+// are sampled once per task instance; CPU is relative to one core (1000 permille).
+// No-op unless CONFIG_STACKCHAN_MEDIA_DIAGNOSTICS and FreeRTOS tracing are enabled.
+void stackchan_task_diagnostics(void);
