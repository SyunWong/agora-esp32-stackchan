+#pragma once
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Official DefaultAvatar neutral + blink subset for the identified ILI9342C.
+// Call init after init_board(), before starting media. All functions must be
+// called from the same application task, never an audio/RTC callback or ISR.
+// init returns ESP_OK or an ESP error. On failure audio may continue headless.
+int stackchan_status_init(void);
+// Uppercase ASCII labels, maximum 26 characters. READY/RTC READY show the pure
+// official face without a label. Only changed label pixels redraw after init.
+// A transfer timeout permanently disables display updates until reboot, keeping
+// its DMA buffer alive so a late completion cannot access freed/reused memory.
+void stackchan_status_show(const char *label);
+// Call from the same task about every 100 ms. Each blink transition submits
+// exactly two 20x20 eye rectangles; no additional framebuffer or task.
+void stackchan_status_tick(uint32_t now_ms);
