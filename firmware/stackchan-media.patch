+static esp_capture_err_t uplink_meter(esp_capture_audio_src_if_t *src,
+                                     esp_capture_stream_frame_t *frame)
+{
+    int64_t read_started_us = esp_timer_get_time();
+    esp_capture_err_t ret = source_read_frame(src, frame);
+    if (ret != ESP_CAPTURE_ERR_OK || !frame || !frame->data || frame->size < 2) return ret;
+    raw_input_meter();
+    static uint64_t energy;
+    static uint32_t sampled_values, pcm_samples, sampled_peak, blocks, previous_pts;
+    static int64_t window_started_us;
+    static bool have_pts;
+    if (have_pts && frame->pts <= previous_pts) {
+        // A restarted capture has a new PTS origin; never mix session windows.
+        energy = 0; sampled_values = 0; pcm_samples = 0; sampled_peak = 0; blocks = 0;
+    }
