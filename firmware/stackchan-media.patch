+
+typedef struct {
+    media_t media;
+    bool ai_requested;             // Explicit companion intent, not temporary ring AI.
+    bool resume_ai;
+    bool human_uplink;
+    char ai_request_id[33];        // Retained until /ai/stop confirms cleanup.
+    char ai_session_id[65];
+    char call_id[33];
+    char finished_call_id[33];
+    char reason[49];
+    call_state_t call_state;
+    char url[256];                 // Must outlive the WebRTC signaling session.
+    char token[1024];
+    time_t expires;
+    unsigned idle_poll_failures;
+    int64_t next_poll, next_heartbeat, next_query, next_action, accepting_since;
+} interaction_t;
+
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+enum { TRACE_CONNECTED, TRACE_HEADERS_SENT, TRACE_STATUS, TRACE_HEADERS_COMPLETE,
+       TRACE_BODY, TRACE_FINISH, TRACE_EVENT_COUNT };
+typedef struct {
+    unsigned request, handle, connection;
+    bool cold_handle;
+    unsigned count[TRACE_EVENT_COUNT];
+    int64_t started_us, first_ms[TRACE_EVENT_COUNT];
+    unsigned body_bytes;
+} control_trace_t;
+// Single control-worker ownership, including synchronous HTTP callbacks.
+static unsigned trace_request, trace_handle, trace_connection, trace_current_connection;
+static bool trace_had_success, trace_recovering;
+
+static void trace_increment(unsigned *value)
+{
+    if (*value < UINT_MAX) ++*value;
+}
+
+static void trace_event(control_trace_t *trace, unsigned event)
+{
+    if (!trace->count[event]) trace->first_ms[event] = (esp_timer_get_time() - trace->started_us) / 1000;
+    trace_increment(&trace->count[event]);
+}
+#endif
+
+typedef struct {
+    char data[RESPONSE_BYTES]; size_t used; bool overflow, connected;
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    control_trace_t trace;
+#endif
+} response_t;
+typedef enum { CONTROL_OK, CONTROL_TRANSPORT, CONTROL_HTTP, CONTROL_PROTOCOL,
+               CONTROL_AUTH, CONTROL_PENDING, CONTROL_LOCAL } control_kind_t;
+typedef struct {
+    // Only successful replies own JSON. Error codes point to fixed literals;
+    // neither an upstream body nor a borrowed JSON string escapes control().
+    cJSON *json;
+    control_kind_t kind;
+    esp_err_t transport;
+    int http_status;
+    const char *code;
+} control_result_t;
+
+static const char *control_error_code(const cJSON *json)
+{
+    static const char *const allowed[] = {
+        "cleanup_pending", "forbidden", "service_unavailable", "service_not_enabled",
+        "rate_limited", "invalid_request", "session_busy", "session_not_active",
+        "session_expired", "request_already_stopped", "human_call_in_progress",
+        "call_not_current", "call_not_accepted", "call_not_connecting",
+    };
+    const cJSON *error = cJSON_GetObjectItemCaseSensitive(json, "error");
+    if (cJSON_IsString(error)) {
+        for (size_t i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i)
+            if (!strcmp(error->valuestring, allowed[i])) return allowed[i];
+    }
+    return "unclassified";
+}
+
+// Owned exclusively by session_worker. Keep the TLS connection across polls;
+// audio tasks and touch handlers never access this handle.
+static esp_http_client_handle_t control_client;
+
+static void close_control(void)
+{
+    if (control_client) esp_http_client_cleanup(control_client);
+    control_client = NULL;
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    trace_current_connection = 0;
+#endif
+}
+
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+static void log_control_trace(const response_t *response, control_kind_t kind, int status, int64_t elapsed_ms)
+{
+    const control_trace_t *t = &response->trace;
+    ESP_LOGI(TAG, "Control stages req=%u handle=%u connection=%u cold_handle=%d kind=%d status=%d elapsed_ms=%lld recovery=%d",
+             t->request, t->handle, t->connection, t->cold_handle, kind, status, (long long)elapsed_ms, trace_recovering);
+    // Counts and first-event offsets only. Never inspect header/status event
+    // payloads here; in particular no URLs, authorization or JSON are logged.
+    ESP_LOGI(TAG, "Control events req=%u connected=%u/%lld headers_sent=%u/%lld status=%u/%lld headers_complete=%u/%lld body=%u/%lld body_bytes=%u finish=%u/%lld",
+             t->request, t->count[TRACE_CONNECTED], (long long)t->first_ms[TRACE_CONNECTED],
+             t->count[TRACE_HEADERS_SENT], (long long)t->first_ms[TRACE_HEADERS_SENT],
+             t->count[TRACE_STATUS], (long long)t->first_ms[TRACE_STATUS],
+             t->count[TRACE_HEADERS_COMPLETE], (long long)t->first_ms[TRACE_HEADERS_COMPLETE],
+             t->count[TRACE_BODY], (long long)t->first_ms[TRACE_BODY], t->body_bytes,
+             t->count[TRACE_FINISH], (long long)t->first_ms[TRACE_FINISH]);
+    if (kind != CONTROL_OK) {
+        wifi_ap_record_t ap = {0};
+        esp_err_t wifi_result = esp_wifi_sta_get_ap_info(&ap);
+        ESP_LOGI(TAG, "Control environment req=%u wifi_result=%d rssi=%d channel=%u internal_free=%u internal_largest=%u",
+                 t->request, wifi_result, wifi_result == ESP_OK ? ap.rssi : -128,
+                 wifi_result == ESP_OK ? (unsigned)ap.primary : 0,
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
+    }
+}
+#endif
+
+static bool current(unsigned epoch)
+{
+    return !atomic_load(&shutting_down) && atomic_load(&generation) == epoch;
+}
+
+// Publish only a desired pose. The motion API is atomic/nonblocking: no motor
+// I/O, allocation or waits here, including while holding the UI state lock.
+static void request_phase_motion(phase_t value)
+{
+#ifdef CONFIG_STACKCHAN_HEAD_MOTION
+    stackchan_motion_pose_t pose = STACKCHAN_MOTION_ATTENTIVE;
+    if (value == IDLE) pose = STACKCHAN_MOTION_REST;
+    else if (value == ACCEPTING || value == HUMAN_CONNECTING || value == HUMAN_ACTIVE ||
+             value == STOPPING || value == FAILED) pose = STACKCHAN_MOTION_HOLD;
+    stackchan_motion_request(pose);
+#else
+    (void)value;
+#endif
+}
+
+static bool motion_pose_ready(void)
+{
+#ifdef CONFIG_STACKCHAN_HEAD_MOTION
+    // A disabled/failed motor returns ready so calls never depend on movement.
+    return stackchan_motion_settled();
+#else
+    return true;
+#endif
+}
+
+static void show_phase(phase_t value)
+{
+    portENTER_CRITICAL(&state_lock);
+    if (pending_command == COMMAND_NONE && !atomic_load(&shutting_down)) {
+        atomic_store(&phase, value);
+        request_phase_motion(value);
+    }
+    portEXIT_CRITICAL(&state_lock);
+}
+
+static bool enable_uplink(unsigned epoch)
+{
+    bool allowed;
+    portENTER_CRITICAL(&state_lock);
+    allowed = current(epoch) && pending_command == COMMAND_NONE;
+    if (allowed) webrtc_set_uplink_enabled(true);
+    portEXIT_CRITICAL(&state_lock);
+    return allowed;
+}
+
+static void set_control_nodelay(esp_http_client_handle_t client)
+{
+    // ON_CONNECTED runs after TLS completes and before HTTP writes. Apply once
+    // to this connection only; never retain or close its borrowed socket.
+    int saved_errno = errno;
+    int fd = esp_http_client_get_socket(client);
+    int enabled = 1, result = -1, option_errno = 0;
+    if (fd >= 0) {
+        result = setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &enabled, sizeof(enabled));
+        if (result != 0) option_errno = errno;
+    }
+    if (result != 0) {
+        ESP_LOGW(TAG, "Control nodelay socket_valid=%d set_result=%d errno=%d", fd >= 0, result, option_errno);
+    }
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    else {
+        int readback = -1;
+        socklen_t length = sizeof(readback);
+        int read_result = getsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &readback, &length);
+        int read_errno = read_result != 0 ? errno : 0;
+        if (read_result != 0 || length != sizeof(readback)) readback = -1;
+        ESP_LOGI(TAG, "Control nodelay socket_valid=1 set_result=0 read_result=%d read_errno=%d enabled=%d",
+                 read_result, read_errno, readback);
+    }
+#endif
+    // Even a failed option/readback or logger must not change HTTP error state.
+    errno = saved_errno;
+}
+
+static esp_err_t receive_http(esp_http_client_event_t *event)
+{
+    response_t *r = event->user_data;
+    if (event->event_id == HTTP_EVENT_ON_CONNECTED) {
+        set_control_nodelay(event->client);
+        if (r) r->connected = true;
+    }
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    if (r) {
+        switch (event->event_id) {
+        case HTTP_EVENT_ON_CONNECTED:
+            trace_increment(&trace_connection);
+            r->trace.connection = trace_current_connection = trace_connection;
+            trace_event(&r->trace, TRACE_CONNECTED); break;
+        case HTTP_EVENT_HEADERS_SENT: trace_event(&r->trace, TRACE_HEADERS_SENT); break;
+        case HTTP_EVENT_ON_STATUS_CODE: trace_event(&r->trace, TRACE_STATUS); break;
+        case HTTP_EVENT_ON_HEADERS_COMPLETE: trace_event(&r->trace, TRACE_HEADERS_COMPLETE); break;
+        case HTTP_EVENT_ON_FINISH: trace_event(&r->trace, TRACE_FINISH); break;
+        case HTTP_EVENT_ON_DATA:
+            if (event->data_len > 0) {
+                trace_event(&r->trace, TRACE_BODY);
+                unsigned bytes = (unsigned)event->data_len;
+                r->trace.body_bytes = bytes > UINT_MAX - r->trace.body_bytes ? UINT_MAX : r->trace.body_bytes + bytes;
+            }
+            break;
+        default: break;
+        }
+    }
+#endif
+    if (r && event->event_id == HTTP_EVENT_ON_DATA && event->data_len > 0) {
+        if ((size_t)event->data_len >= sizeof(r->data) - r->used) {
+            r->overflow = true; return ESP_FAIL;
+        }
+        memcpy(r->data + r->used, event->data, event->data_len);
+        r->used += event->data_len;
+        r->data[r->used] = 0;
+    }
+    return ESP_OK;
+}
+
+// A provisioned HTTPS origin is used in cloud mode; HTTP remains available for
+// the private LAN fallback. Never follow redirects with the device bearer key.
+static control_result_t control(const char *path, const char *body, int timeout_ms)
+{
+    char url[192];
+    response_t response = {0};
+    control_result_t result = {.kind = CONTROL_LOCAL, .code = "local_configuration"};
+    bool secure = strncmp(STACKCHAN_CONTROL_URL, "https://", 8) == 0;
+    if (!secure && strncmp(STACKCHAN_CONTROL_URL, "http://", 7) != 0) return result;
+    if (secure && timeout_ms < 5000) timeout_ms = 5000;
+    int length = snprintf(url, sizeof(url), "%s%s", STACKCHAN_CONTROL_URL, path);
+    if (length < 0 || length >= (int)sizeof(url)) return result;
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    trace_increment(&trace_request);
+    response.trace.request = trace_request;
+    response.trace.cold_handle = !control_client;
+    for (unsigned i = 0; i < TRACE_EVENT_COUNT; ++i) response.trace.first_ms[i] = -1;
+#endif
+    if (!control_client) {
+        esp_http_client_config_t cfg = {
+            .url = url, .method = HTTP_METHOD_POST, .timeout_ms = timeout_ms,
+            .buffer_size = 512, .buffer_size_tx = 512,
+            .event_handler = receive_http,
+            .disable_auto_redirect = true,
+            .crt_bundle_attach = secure ? esp_crt_bundle_attach : NULL,
+            .keep_alive_enable = true,
+        };
+        control_client = esp_http_client_init(&cfg);
+        if (!control_client) { result.code = "client_initialization"; return result; }
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+        trace_increment(&trace_handle);
+#endif
+    }
+    int64_t started = esp_timer_get_time();
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    response.trace.started_us = started;
+    response.trace.handle = trace_handle;
+    response.trace.connection = trace_current_connection;
+#endif
+    esp_err_t err = esp_http_client_set_url(control_client, url);
+    if (err == ESP_OK) err = esp_http_client_set_timeout_ms(control_client, timeout_ms);
+    if (err == ESP_OK) err = esp_http_client_set_user_data(control_client, &response);
+    if (err == ESP_OK) err = esp_http_client_set_header(control_client, "Authorization", "Bearer " STACKCHAN_CONTROL_KEY);
+    if (err == ESP_OK) err = esp_http_client_set_header(control_client, "Content-Type", "application/json");
+    if (err == ESP_OK) err = esp_http_client_set_post_field(control_client, body, strlen(body));
+    if (err == ESP_OK) {
+#ifdef CONFIG_STACKCHAN_TLS_HANDSHAKE_DIAGNOSTICS
+        stackchan_tls_diagnostics_begin(response.trace.request);
+#endif
+        err = esp_http_client_perform(control_client);
+#ifdef CONFIG_STACKCHAN_TLS_HANDSHAKE_DIAGNOSTICS
+        stackchan_tls_diagnostics_end();
+#endif
+    }
+    int64_t elapsed_ms = (esp_timer_get_time() - started) / 1000;
+    int status = esp_http_client_get_status_code(control_client);
+    // The client borrows these pointers; neither may outlive this stack frame.
+    esp_http_client_set_user_data(control_client, NULL);
+    esp_http_client_set_post_field(control_client, NULL, 0);
+    result.transport = err;
+    result.http_status = status;
+    if (response.overflow) {
+        result.kind = CONTROL_PROTOCOL;
+        result.code = "response_too_large";
+    } else if (err != ESP_OK) {
+        result.kind = CONTROL_TRANSPORT;
+        result.code = "transport_failed";
+    } else {
+        cJSON *json = cJSON_ParseWithOpts(response.data, NULL, true);
+        if (status != 200) {
+            result.kind = status == 401 || status == 403 ? CONTROL_AUTH : CONTROL_HTTP;
+            result.code = control_error_code(json);
+            if (status == 409 && !strcmp(result.code, "cleanup_pending")) result.kind = CONTROL_PENDING;
+        } else if (!cJSON_IsObject(json)) {
+            result.kind = CONTROL_PROTOCOL;
+            result.code = "invalid_response";
+        } else {
+            result.kind = CONTROL_OK;
+            result.code = "ok";
+            result.json = json;
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+            if (!trace_had_success || trace_recovering) log_control_trace(&response, result.kind, status, elapsed_ms);
+            trace_had_success = true;
+            trace_recovering = false;
+#endif
+            return result;
+        }
+        cJSON_Delete(json);
+    }
+    ESP_LOGW(TAG, "Control %s failed: kind=%d transport=%d status=%d code=%s",
+             path, result.kind, result.transport, result.http_status, result.code);
+    // Read transport evidence before cleanup destroys it. This is numeric only;
+    // connected means an ON_CONNECTED event in this request, not a reused socket.
+    int socket_errno = esp_http_client_get_errno(control_client);
+    int mbed_error = 0, cert_flags = 0;
+    esp_err_t tls_error = esp_http_client_get_and_clear_last_tls_error(control_client, &mbed_error, &cert_flags);
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    log_control_trace(&response, result.kind, status, elapsed_ms);
+    trace_recovering = true;
+    ESP_LOGW(TAG, "Control diagnostic req=%u handle=%u connection=%u cold_handle=%d timeout_ms=%d elapsed_ms=%lld errno=%d tls=%d mbed=%d certflags=%d connected=%d",
+             response.trace.request, response.trace.handle, response.trace.connection, response.trace.cold_handle,
+             timeout_ms, (long long)elapsed_ms, socket_errno, tls_error, mbed_error, cert_flags, response.connected);
+#else
+    ESP_LOGW(TAG, "Control diagnostic timeout_ms=%d elapsed_ms=%lld errno=%d tls=%d mbed=%d certflags=%d connected=%d",
+             timeout_ms, (long long)elapsed_ms, socket_errno, tls_error, mbed_error, cert_flags, response.connected);
+#endif
+    // A normal cleanup wait can reuse its healthy TLS connection. Never replay
+    // any POST automatically; the state owner decides what happens next.
+    if (result.kind != CONTROL_PENDING) close_control();
+    return result;
+}
+
+static control_result_t ai_control(const char *action, const char *key, const char *id, int timeout_ms)
+{
+    char path[32], body[112];
+    snprintf(path, sizeof(path), "/ai/%s", action);
+    snprintf(body, sizeof(body), "{\"%s\":\"%s\"}", key, id);
+    return control(path, body, timeout_ms);
+}
+
+static control_result_t call_control(const interaction_t *ctx, const char *action)
+{
+    char body[112];
+    if (!ctx->call_id[0]) return (control_result_t){.kind = CONTROL_LOCAL, .code = "no_call"};
+    snprintf(body, sizeof(body), "{\"call_id\":\"%s\",\"action\":\"%s\"}", ctx->call_id, action);
+    return control("/device/call", body, 2000);
+}
+
+static bool copy_string(cJSON *json, const char *key, char *out, size_t size)
+{
+    const cJSON *item = cJSON_GetObjectItemCaseSensitive(json, key);
+    if (!cJSON_IsString(item) || !item->valuestring[0] || strlen(item->valuestring) >= size) return false;
+    strcpy(out, item->valuestring); return true;
+}
+
+static bool identifier(const char *value)
+{
+    if (strlen(value) != 32) return false;
+    for (int i = 0; i < 32; ++i)
+        if (!((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f'))) return false;
+    return true;
+}
+
+static call_state_t parse_call_state(const char *value)
+{
+    if (strcmp(value, "ringing") == 0) return CALL_RINGING;
+    if (strcmp(value, "accepting") == 0) return CALL_ACCEPTING;
+    if (strcmp(value, "connecting") == 0) return CALL_CONNECTING;
+    if (strcmp(value, "active") == 0) return CALL_ACTIVE;
+    if (strcmp(value, "ended") == 0) return CALL_ENDED;
+    return CALL_NONE;
+}
+
+static bool ingest_call(interaction_t *ctx, cJSON *response)
+{
+    cJSON *call = cJSON_GetObjectItemCaseSensitive(response, "call");
+    if (cJSON_IsNull(call)) return !ctx->call_id[0];
+    char id[33], state_text[16];
+    if (!cJSON_IsObject(call) || !copy_string(call, "id", id, sizeof(id)) || !identifier(id) ||
+        !copy_string(call, "state", state_text, sizeof(state_text))) return false;
+    call_state_t next = parse_call_state(state_text);
+    if (next == CALL_NONE) return false;
+    if (!ctx->call_id[0]) {
+        if (next == CALL_ENDED || strcmp(id, ctx->finished_call_id) == 0) return true;
+        if (next != CALL_RINGING) return false;
+        strcpy(ctx->call_id, id);
+        ctx->resume_ai = ctx->ai_requested;
+        ctx->accepting_since = 0;
+        ctx->next_action = 0;
+        ESP_LOGI(TAG, "Incoming call; prior companion=%d", ctx->resume_ai);
+    } else if (strcmp(ctx->call_id, id) != 0) {
+        return false;
+    }
+    // A late response can never roll an accepted/ended call back to ringing.
+    if (next < ctx->call_state) return false;
+    bool entering_connecting = next == CALL_CONNECTING && ctx->call_state < CALL_CONNECTING;
+    ctx->call_state = next;
+    ctx->reason[0] = 0;
+    cJSON *reason = cJSON_GetObjectItemCaseSensitive(call, "reason");
+    if (cJSON_IsString(reason) && strlen(reason->valuestring) < sizeof(ctx->reason)) strcpy(ctx->reason, reason->valuestring);
+    if ((next == CALL_ACCEPTING && !ctx->accepting_since) || entering_connecting)
+        ctx->accepting_since = esp_timer_get_time();
+    return true;
+}
+
+static const char *poll_state(const interaction_t *ctx)
+{
+    phase_t p = atomic_load(&phase);
+    // Existing cloud announcement gating waits for this state. Keep local
+    // RINGING/tap-to-answer available while a small initial lift completes.
+    if (p == RINGING) return motion_pose_ready() ? "ringing" : "transition";
+    if (p == HUMAN_ACTIVE) return "human";
+    if (p == AI_ACTIVE) return "ai";
+    if ((p == IDLE || p == FAILED) && ctx->media == MEDIA_NONE) return "idle";
+    return "transition";
+}
+
+static bool poll_device(interaction_t *ctx)
+{
+    char body[256];
+    snprintf(body, sizeof(body), "{\"state\":\"%s\",\"ai_session_id\":\"%s\",\"call_id\":\"%s\",\"media_connected\":%s}",
+             poll_state(ctx), ctx->ai_session_id, ctx->call_id,
+             ctx->media != MEDIA_NONE && webrtc_is_connected() ? "true" : "false");
+    // Only a cold standby HTTPS poll may wait longer for a hotspot handshake.
+    // The context/client belong to this worker; snapshot UI intent under its
+    // existing lock, without holding it across network I/O. Active/cleanup/
+    // cancellation paths retain their original bound and generation barrier.
+    portENTER_CRITICAL(&state_lock);
+    phase_t p = atomic_load(&phase);
+    bool standby = (p == IDLE || p == FAILED) && pending_command == COMMAND_NONE && !atomic_load(&shutting_down);
+    portEXIT_CRITICAL(&state_lock);
+    standby = standby && ctx->media == MEDIA_NONE && !ctx->call_id[0] && !ctx->ai_requested &&
+              !ctx->ai_request_id[0] && !ctx->ai_session_id[0];
+    int timeout_ms = standby && !control_client && strncmp(STACKCHAN_CONTROL_URL, "https://", 8) == 0 ? 15000 : 2000;
+    control_result_t result = control("/device/poll", body, timeout_ms);
+    bool ok = result.json && ingest_call(ctx, result.json);
+    cJSON_Delete(result.json);
+    bool idle = ctx->media == MEDIA_NONE && !ctx->call_id[0] && !ctx->ai_requested;
+    int64_t delay = POLL_US;
+    if (ok || !idle) ctx->idle_poll_failures = 0;
+    else {
+        // Equal jitter: 1..2, 2..4, 4..8, 8..16, then 15..30 seconds.
+        // Only standby backs off. Active failures still close audio immediately.
+        if (ctx->idle_poll_failures < 5) ++ctx->idle_poll_failures;
+        int64_t ceiling = POLL_US << ctx->idle_poll_failures;
+        if (ceiling > IDLE_POLL_MAX_US) ceiling = IDLE_POLL_MAX_US;
+        delay = ceiling / 2 + esp_random() % (ceiling / 2 + 1);
+    }
+    ctx->next_poll = esp_timer_get_time() + delay;
+    return ok;
+}
+
+static void close_media(interaction_t *ctx)
+{
+    webrtc_set_uplink_enabled(false);
+    if (ctx->media != MEDIA_NONE) stop_webrtc();
+    ctx->media = MEDIA_NONE;
+    ctx->human_uplink = false;
+    ctx->url[0] = 0;
+    memset(ctx->token, 0, sizeof(ctx->token));
+    ctx->expires = 0;
+}
+
+static bool stop_ai(interaction_t *ctx)
+{
+    if (ctx->media == MEDIA_AI) close_media(ctx);
+    if (!ctx->ai_request_id[0]) return true;
+    cJSON *reply = ai_control("stop", "request_id", ctx->ai_request_id, 5000).json;
+    cJSON *value = reply ? cJSON_GetObjectItemCaseSensitive(reply, "state") : NULL;
+    bool ok = cJSON_IsString(value) && strcmp(value->valuestring, "stopped") == 0;
+    cJSON_Delete(reply);
+    if (ok) {
+        ctx->ai_request_id[0] = 0;
+        ctx->ai_session_id[0] = 0;
+    }
+    return ok;
+}
+
+static void forget_call(interaction_t *ctx)
+{
+    if (ctx->call_id[0]) strcpy(ctx->finished_call_id, ctx->call_id);
+    ctx->call_id[0] = 0;
+    ctx->call_state = CALL_NONE;
+    ctx->resume_ai = false;
+    ctx->accepting_since = 0;
+    ctx->next_action = 0;
+}
+
+static void fail_closed(interaction_t *ctx)
+{
+    webrtc_set_uplink_enabled(false);
+    show_phase(STOPPING);
+    close_media(ctx);
+    ctx->ai_requested = false;
+    ctx->resume_ai = false;
+    if (network_is_connected()) {
+        (void)stop_ai(ctx);
+        cJSON *reply = call_control(ctx, "end").json;
+        cJSON_Delete(reply);
+    }
+    forget_call(ctx);
+    atomic_store(&quiescent, true);
+    show_phase(FAILED);
+    ESP_LOGW(TAG, "Session closed locally; explicit retry required");
+}
+
+static bool poll_or_close(interaction_t *ctx)
+{
+    if (poll_device(ctx)) return true;
+    if (ctx->media != MEDIA_NONE || ctx->call_id[0] || ctx->ai_requested) fail_closed(ctx);
+    else show_phase(FAILED);
+    return false;
+}
+
+static bool normal_end(const char *reason)
+{
+    return strcmp(reason, "caller_hangup") == 0 || strcmp(reason, "device_hangup") == 0 ||
+           strcmp(reason, "rejected") == 0 || strcmp(reason, "caller_cancel") == 0 ||
+           strcmp(reason, "ringing_timeout") == 0;
+}
+
+static void finish_call(interaction_t *ctx, unsigned epoch)
+{
+    bool restore = normal_end(ctx->reason) && ctx->resume_ai;
+    bool keep_ai = restore && ctx->media == MEDIA_AI;
+    if (!keep_ai) close_media(ctx);
+    if (!keep_ai && !stop_ai(ctx)) { fail_closed(ctx); return; }
+    if (!normal_end(ctx->reason)) { fail_closed(ctx); return; }
+    forget_call(ctx);
+    if (!current(epoch)) restore = false;
+    ctx->ai_requested = restore;
+    atomic_store(&quiescent, !keep_ai);
+    if (keep_ai) enable_uplink(epoch);
+    show_phase(keep_ai ? AI_ACTIVE : restore ? RESUMING : IDLE);
+    ESP_LOGI(TAG, "Call ended; restore prior companion=%d", restore);
+}
+
+static bool read_grant(interaction_t *ctx, cJSON *grant, media_t kind)
+{
+    char session_id[65];
+    const cJSON *expires = cJSON_GetObjectItemCaseSensitive(grant, "expires_at");
+    const cJSON *server_time = cJSON_GetObjectItemCaseSensitive(grant, "server_time");
+    const char *prefix = kind == MEDIA_HUMAN ?
+        "https://ap-webrtc-whip.ap.sd-rtn.com/pub/stackchan-human-" :
+        "https://ap-webrtc-whip.ap.sd-rtn.com/pub/stackchan-ai-";
+    if (!copy_string(grant, "session_id", session_id, sizeof(session_id)) || !identifier(session_id) ||
+        (kind == MEDIA_HUMAN && strcmp(session_id, ctx->call_id) != 0) ||
+        !copy_string(grant, "whip_url", ctx->url, sizeof(ctx->url)) ||
+        !copy_string(grant, "whip_token", ctx->token, sizeof(ctx->token)) ||
+        strncmp(ctx->url, prefix, strlen(prefix)) != 0 ||
+        !cJSON_IsNumber(server_time) || server_time->valuedouble < 1704067200 ||
+        !cJSON_IsNumber(expires) || !(expires->valuedouble > server_time->valuedouble) ||
+        !(expires->valuedouble <= server_time->valuedouble + 900)) return false;
+    const char *query = strchr(ctx->url, '?');
+    if (!query || strcmp(query, "?stringuid=20001&duplex=true") != 0) return false;
+    struct timeval tv = {.tv_sec = (time_t)server_time->valuedouble};
+    if (settimeofday(&tv, NULL) != 0) return false;
+    ctx->expires = (time_t)expires->valuedouble;
+    if (kind == MEDIA_AI) strcpy(ctx->ai_session_id, session_id);
+    return true;
+}
+
+static bool open_media(interaction_t *ctx, media_t kind, unsigned epoch)
+{
+    if (!current(epoch) || !network_is_connected() || ctx->media != MEDIA_NONE) return false;
+    webrtc_set_uplink_enabled(false);
+    // The previous capture must be closed before selecting the next DSP profile.
+    stackchan_afe_set_human_call(kind == MEDIA_HUMAN);
+    ctx->media = kind;
+    int result = start_webrtc(ctx->url, ctx->token);
+    // Signaling duplicates bearer_token; signal_url stays owned by this context.
+    memset(ctx->token, 0, sizeof(ctx->token));
+    ctx->next_heartbeat = esp_timer_get_time() + 10000000;
+    ctx->next_query = esp_timer_get_time() + 5000000;
+    return result == 0 && current(epoch);
+}
+
+static void start_ai(interaction_t *ctx, unsigned epoch)
+{
+    atomic_store(&quiescent, false);
+    show_phase(ctx->call_state == CALL_RINGING ? RING_STARTING : AI_STARTING);
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (!current(epoch) || ctx->call_state >= CALL_ACCEPTING) return;
+    bool had_cleanup = ctx->ai_request_id[0] != 0;
+    if (!stop_ai(ctx)) { fail_closed(ctx); return; }
+    if (!current(epoch)) return;
+    if (had_cleanup) {
+        // A retry may have retained a cloud session ID after local shutdown.
+        // Confirm its now-empty identity before a fresh grant can be issued.
+        if (!poll_device(ctx)) { fail_closed(ctx); return; }
+        if (!current(epoch) || ctx->call_state >= CALL_ACCEPTING) return;
+    }
+    snprintf(ctx->ai_request_id, sizeof(ctx->ai_request_id), "%08lx%08lx%08lx%08lx",
+             (unsigned long)esp_random(), (unsigned long)esp_random(),
+             (unsigned long)esp_random(), (unsigned long)esp_random());
+    cJSON *grant = ai_control("start", "request_id", ctx->ai_request_id, 30000).json;
+    bool valid = grant && read_grant(ctx, grant, MEDIA_AI);
+    cJSON_Delete(grant);
+    if (!current(epoch)) return;
+    if (!valid) { fail_closed(ctx); return; }
+    // Renew transition grace between the two bounded cloud/signaling operations.
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (ctx->call_state >= CALL_ACCEPTING || !current(epoch)) return;
+    if (!open_media(ctx, MEDIA_AI, epoch)) { if (current(epoch)) fail_closed(ctx); return; }
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (ctx->call_state >= CALL_ACCEPTING || !current(epoch)) return;
+    if (!enable_uplink(epoch)) return;
+    show_phase(ctx->call_state == CALL_RINGING ? RINGING : AI_STARTING);
+}
+
+static void start_ai_when_pose_ready(interaction_t *ctx, unsigned epoch)
+{
+    // Keep polling and touch cancellation live while lifting. In particular,
+    // an idle incoming call must not start the temporary AI greeting/ASR over
+    // motor noise. Already-attentive, disabled and failed motors do not delay.
+    if (motion_pose_ready()) start_ai(ctx, epoch);
+}
+
+static void accept_step(interaction_t *ctx, unsigned epoch)
+{
+    webrtc_set_uplink_enabled(false);
+    show_phase(ACCEPTING);
+    if (esp_timer_get_time() - ctx->accepting_since > ACCEPT_TIMEOUT_US) { fail_closed(ctx); return; }
+    if (esp_timer_get_time() < ctx->next_action) return;
+    ctx->next_action = esp_timer_get_time() + POLL_US;
+    // Tell the lease owner that blocking media/AI cleanup is about to begin.
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (ctx->call_state == CALL_ENDED || !current(epoch)) return;
+    // Privacy barrier: close local capture/playout and confirm cloud AI cleanup
+    // before requesting any credential for the separate private human channel.
+    if (ctx->media != MEDIA_NONE) close_media(ctx);
+    if (!stop_ai(ctx) || !current(epoch)) return;
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (ctx->call_state == CALL_ENDED || !current(epoch)) return;
+    if (ctx->call_state != CALL_ACCEPTING && ctx->call_state != CALL_CONNECTING) { fail_closed(ctx); return; }
+    control_result_t result = call_control(ctx, "ready");
+    cJSON *reply = result.json;
+    if (!reply) {
+        // Pending cleanup and temporary upstream failures remain bounded by the
+        // existing accepting deadline. Authentication/protocol faults cannot heal
+        // by repeatedly asking for a human grant.
+        if (result.kind == CONTROL_AUTH || result.kind == CONTROL_PROTOCOL || result.kind == CONTROL_LOCAL)
+            fail_closed(ctx);
+        return;
+    }
+    bool snapshot_ok = ingest_call(ctx, reply);
+    cJSON *grant = cJSON_GetObjectItemCaseSensitive(reply, "grant");
+    bool valid = snapshot_ok && ctx->call_state == CALL_CONNECTING &&
+                 cJSON_IsObject(grant) && read_grant(ctx, grant, MEDIA_HUMAN);
+    cJSON_Delete(reply);
+    if (!current(epoch) || ctx->call_state == CALL_ENDED) return;
+    if (!valid) { fail_closed(ctx); return; }
+    show_phase(HUMAN_CONNECTING);
+    if (!open_media(ctx, MEDIA_HUMAN, epoch)) { if (current(epoch)) fail_closed(ctx); return; }
+    ctx->next_poll = 0;
+    ctx->next_action = 0;
+}
+
+static void human_step(interaction_t *ctx, unsigned epoch)
+{
+    if (ctx->media != MEDIA_HUMAN) {
+        // Retry a lost ready reply through the same confirmed cleanup barrier.
+        accept_step(ctx, epoch);
+        return;
+    }
+    if (!network_is_connected() || webrtc_needs_restart() || time(NULL) >= ctx->expires) { fail_closed(ctx); return; }
+    if (!webrtc_is_connected() || ctx->human_uplink || esp_timer_get_time() < ctx->next_action) return;
+    ctx->next_action = esp_timer_get_time() + POLL_US;
+    if (!poll_device(ctx)) { fail_closed(ctx); return; }
+    if (ctx->call_state == CALL_ENDED || !current(epoch)) return;
+    cJSON *reply = call_control(ctx, "connected").json;
+    if (!reply) return;
+    bool valid = ingest_call(ctx, reply);
+    cJSON_Delete(reply);
+    if (!valid) { fail_closed(ctx); return; }
+    if (ctx->call_state == CALL_ACTIVE && current(epoch)) {
+        ctx->human_uplink = enable_uplink(epoch);
+        if (ctx->human_uplink) show_phase(HUMAN_ACTIVE);
+    }
+}
+
+static void monitor_media(interaction_t *ctx)
+{
+    if (ctx->media == MEDIA_NONE) return;
+    if (!network_is_connected() || webrtc_needs_restart() || time(NULL) >= ctx->expires) { fail_closed(ctx); return; }
+    int64_t now = esp_timer_get_time();
+    if (ctx->media == MEDIA_AI) {
+        if (ctx->call_state >= CALL_ACCEPTING) return;
+        if (webrtc_is_connected()) show_phase(ctx->call_state == CALL_RINGING ? RINGING : AI_ACTIVE);
+        if (now >= ctx->next_heartbeat) {
+            cJSON *reply = ai_control("heartbeat", "session_id", ctx->ai_session_id, 2000).json;
+            const cJSON *active = reply ? cJSON_GetObjectItemCaseSensitive(reply, "active") : NULL;
+            bool alive = cJSON_IsTrue(active);
+            cJSON_Delete(reply);
+            ctx->next_heartbeat = esp_timer_get_time() + 10000000;
+            if (!alive) { fail_closed(ctx); return; }
+        }
+    }
+    if (now >= ctx->next_query) {
+        query_webrtc(); media_sys_query();
+        if (webrtc_is_connected()) stackchan_task_diagnostics();
+        ESP_LOGI(TAG, "Media=%s heap internal=%u minimum=%u largest=%u",
+                 ctx->media == MEDIA_HUMAN ? "human" : "ai",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
+        ctx->next_query = now + 5000000;
+    }
+}
+
+static void handle_command(interaction_t *ctx, command_t command, unsigned epoch)
+{
+    if (command == COMMAND_START) {
+        ctx->idle_poll_failures = 0;
+        ctx->next_poll = 0; // An explicit retry never waits for standby backoff.
+        ctx->ai_requested = true;
+        show_phase(AI_STARTING);
+    } else if (command == COMMAND_ACCEPT) {
+        if (!ctx->call_id[0] || ctx->call_state != CALL_RINGING) return;
+        cJSON *reply = call_control(ctx, "accept").json;
+        bool ok = reply && ingest_call(ctx, reply);
+        cJSON_Delete(reply);
+        if (!ok) { fail_closed(ctx); return; }
+        ctx->next_poll = 0;
+    } else if (command == COMMAND_END) {
+        webrtc_set_uplink_enabled(false);
+        if (!poll_device(ctx)) { fail_closed(ctx); return; }
+        close_media(ctx);
+        if (!stop_ai(ctx)) { fail_closed(ctx); return; }
+        cJSON *reply = call_control(ctx, "end").json;
+        bool ok = reply && ingest_call(ctx, reply) && ctx->call_state == CALL_ENDED;
+        cJSON_Delete(reply);
+        if (!ok) { fail_closed(ctx); return; }
+        if (current(epoch)) finish_call(ctx, epoch);
+    } else if (command == COMMAND_STOP || command == COMMAND_SHUTDOWN) {
+        ctx->ai_requested = false;
+        ctx->resume_ai = false;
+        if (network_is_connected()) (void)poll_device(ctx);
+        close_media(ctx);
+        bool clean = stop_ai(ctx);
+        cJSON *reply = call_control(ctx, "end").json;
+        cJSON_Delete(reply);
+        forget_call(ctx);
+        atomic_store(&quiescent, true);
+        show_phase(clean ? IDLE : FAILED);
+    }
+}
+
+static void session_worker(void *unused)
+{
+    (void)unused;
+    interaction_t ctx = {0}; // Persistent strings reside on this PSRAM stack.
+    for (;;) {
+        portENTER_CRITICAL(&state_lock);
+        command_t command = pending_command;
+        pending_command = COMMAND_NONE;
+        unsigned epoch = atomic_load(&generation);
+        portEXIT_CRITICAL(&state_lock);
+        if (command != COMMAND_NONE) handle_command(&ctx, command, epoch);
+        if (atomic_load(&shutting_down)) { close_control(); vTaskDelay(pdMS_TO_TICKS(25)); continue; }
+        if (!current(epoch)) continue;
+        if (!network_is_connected()) {
+            close_control();
+            if (ctx.media != MEDIA_NONE || ctx.call_id[0] || ctx.ai_requested) fail_closed(&ctx);
+            vTaskDelay(pdMS_TO_TICKS(100));
+            continue;
+        }
+        if (esp_timer_get_time() >= ctx.next_poll) {
+            if (!poll_or_close(&ctx)) {
+                vTaskDelay(pdMS_TO_TICKS(25));
+                continue;
+            }
+        }
+        if (!current(epoch)) continue;
+        if (ctx.call_state == CALL_ENDED) finish_call(&ctx, epoch);
+        else if (ctx.call_state == CALL_ACCEPTING) accept_step(&ctx, epoch);
+        else if (ctx.call_state == CALL_CONNECTING || ctx.call_state == CALL_ACTIVE) human_step(&ctx, epoch);
+        else if (ctx.call_state == CALL_RINGING) {
+            show_phase(RINGING);
+            if (ctx.media == MEDIA_NONE) start_ai_when_pose_ready(&ctx, epoch);
+        } else if (ctx.ai_requested && ctx.media == MEDIA_NONE) start_ai_when_pose_ready(&ctx, epoch);
+        if (current(epoch)) monitor_media(&ctx);
+        vTaskDelay(pdMS_TO_TICKS(25));
+    }
+}
+
+int stackchan_interaction_init(void)
+{
+    if (worker) return 0;
+#ifdef CONFIG_STACKCHAN_NETWORK_DIAGNOSTICS
+    // esp-tls logs only destination/connection stages. Never enable HTTP_CLIENT
+    // DEBUG or global DEBUG: HTTP headers can contain the device bearer key.
+    esp_log_level_set("esp-tls", ESP_LOG_DEBUG);
+#endif
+    webrtc_set_uplink_enabled(false);
+    StackType_t *stack = heap_caps_malloc(WORKER_STACK_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!stack) return -1;
+    worker = xTaskCreateStaticPinnedToCore(session_worker, "AI_CONTROL", WORKER_STACK_BYTES,
+                                         NULL, 4, stack, &worker_tcb, 0);
+    if (!worker) { heap_caps_free(stack); return -1; }
+    return 0;
+}
+
+void stackchan_interaction_tap(void)
+{
+    portENTER_CRITICAL(&state_lock);
+    if (atomic_load(&shutting_down)) { portEXIT_CRITICAL(&state_lock); return; }
+    phase_t p = atomic_load(&phase);
+    command_t command = COMMAND_NONE;
+    phase_t next = p;
+    if (p == IDLE || p == FAILED) { command = COMMAND_START; next = AI_STARTING; }
+    else if (p == RINGING || p == RING_STARTING) { command = COMMAND_ACCEPT; next = ACCEPTING; }
+    else if (p == ACCEPTING || p == HUMAN_CONNECTING || p == HUMAN_ACTIVE) { command = COMMAND_END; next = STOPPING; }
+    else if (p == AI_STARTING || p == AI_ACTIVE || p == RESUMING) { command = COMMAND_STOP; next = STOPPING; }
+    if (command != COMMAND_NONE) {
+        webrtc_set_uplink_enabled(false);
+        pending_command = command;
+        atomic_fetch_add(&generation, 1);
+        atomic_store(&phase, next);
+        request_phase_motion(next);
+        atomic_store(&quiescent, false);
+    }
+    portEXIT_CRITICAL(&state_lock);
+}
+
+const char *stackchan_interaction_label(void)
+{
+    switch (atomic_load(&phase)) {
+    case AI_STARTING: return "CONNECTING TAP TO CANCEL";
+    case AI_ACTIVE: return "AI ON TAP TO STOP";
+    case RING_STARTING: return "INCOMING CALL";
+    case RINGING: return "CALL TAP TO ANSWER";
+    case ACCEPTING: return "ANSWERING TAP TO END";
+    case HUMAN_CONNECTING: return "CONNECTING CALL";
+    case HUMAN_ACTIVE: return "PRIVATE CALL TAP TO END";
+    case RESUMING: return "RESUMING AI";
+    case STOPPING: return "STOPPING";
+    case FAILED: return "ERROR TAP TO RETRY";
+    default: return "TAP TO TALK";
+    }
+}
+
+void stackchan_interaction_shutdown(void)
+{
+    portENTER_CRITICAL(&state_lock);
+    atomic_store(&shutting_down, true);
+    webrtc_set_uplink_enabled(false);
+    pending_command = COMMAND_SHUTDOWN;
+    atomic_fetch_add(&generation, 1);
+    atomic_store(&phase, STOPPING);
+#ifdef CONFIG_STACKCHAN_HEAD_MOTION
+    stackchan_motion_request(STACKCHAN_MOTION_OFF);
+#endif
+    portEXIT_CRITICAL(&state_lock);
+}
+
+bool stackchan_interaction_stopped(void)
+{
+    return atomic_load(&quiescent);
+}
diff --git a/solutions/agora_demo/main/stackchan_interaction.h b/solutions/agora_demo/main/stackchan_interaction.h
new file mode 100644
index 0000000..eb789fc
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_interaction.h
@@ -0,0 +1,11 @@
+#pragma once
+#include <stdbool.h>
+
+// All UI calls stay on app_main; the worker owns every media/session operation
+// and polls for incoming calls in standby. Tap starts/stops AI, answers ringing,
+// or ends a human call. Stop/accept taps gate outgoing audio synchronously.
+int stackchan_interaction_init(void);
+void stackchan_interaction_tap(void);
+const char *stackchan_interaction_label(void);
+void stackchan_interaction_shutdown(void);
+bool stackchan_interaction_stopped(void);
diff --git a/solutions/agora_demo/main/stackchan_probe.c b/solutions/agora_demo/main/stackchan_probe.c
new file mode 100644
index 0000000..37745ee
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_probe.c
@@ -0,0 +1,155 @@
+// Offline hardware gate: no network, Agent, NVS writes or servo commands.
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+#include "esp_board_manager.h"
+#include "esp_board_manager_defs.h"
+#include "esp_board_manager_includes.h"
+#include "esp_codec_dev.h"
+#include "esp_capture_audio_aec_src.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+
+#define RATE 16000
+#define SAMPLES 320
+#define BLOCKS 1000
+#ifdef CONFIG_STACKCHAN_PROBE_AEC
+#define PROBE_AEC 1
+#else
+#define PROBE_AEC 0
+#endif
+static const char *TAG = "STACKCHAN_PROBE";
+static esp_codec_dev_handle_t adc, dac;
+static SemaphoreHandle_t finished;
+static uint32_t tx_blocks, tx_errors;
+static portMUX_TYPE stats_lock = portMUX_INITIALIZER_UNLOCKED;
+
+static void writer(void *arg)
+{
+    int32_t pcm[SAMPLES * 2];
+    for (int block = 0; block < BLOCKS; ++block) {
+        // Alternating silence and a quiet 500 Hz tone, with no microphone loopback.
+        bool tone = (block / 100) % 2;
+        for (int i = 0; i < SAMPLES; ++i) {
+            int16_t v = tone ? (int16_t)(6000 * sinf(2 * 3.14159265f * i / 32)) : 0;
+            pcm[i * 2] = pcm[i * 2 + 1] = (int32_t)v * 65536;
+        }
+        int err = esp_codec_dev_write(dac, pcm, sizeof(pcm));
+        portENTER_CRITICAL(&stats_lock);
+        if (err) ++tx_errors; else ++tx_blocks;
+        portEXIT_CRITICAL(&stats_lock);
+        if (err) break;
+    }
+    xSemaphoreGive(finished);
+    vTaskDelete(NULL);
+}
+
+void app_main(void)
+{
+    ESP_LOGI(TAG, "Offline full-duplex probe; 20 seconds; 16 kHz; AEC=%d",
+             PROBE_AEC);
+    ESP_ERROR_CHECK(esp_board_device_init(ESP_BOARD_DEVICE_NAME_AUDIO_ADC));
+    ESP_ERROR_CHECK(esp_board_device_init(ESP_BOARD_DEVICE_NAME_AUDIO_DAC));
+    dev_audio_codec_handles_t *in = NULL, *out = NULL;
+    ESP_ERROR_CHECK(esp_board_device_get_handle(ESP_BOARD_DEVICE_NAME_AUDIO_ADC, (void **)&in));
+    ESP_ERROR_CHECK(esp_board_device_get_handle(ESP_BOARD_DEVICE_NAME_AUDIO_DAC, (void **)&out));
+    assert(in && out && in->codec_dev && out->codec_dev);
+    adc = in->codec_dev;
+    dac = out->codec_dev;
+    esp_codec_dev_sample_info_t input = {.sample_rate = RATE, .bits_per_sample = 16,
+                                       // ES7210 TDM frame is 4 slots; mask selects
+                                       // three samples in FL, RE, FR wire order.
+                                       .channel = 4, .channel_mask = 7};
+    // AW88298 must be told 32-bit stereo to match the shared 64-BCLK frame.
+    esp_codec_dev_sample_info_t output = {.sample_rate = RATE, .bits_per_sample = 32,
+                                        .channel = 2};
+    ESP_ERROR_CHECK(esp_codec_dev_set_in_gain(adc, 18));
+    ESP_ERROR_CHECK(esp_codec_dev_set_out_vol(dac, 45));
+    ESP_ERROR_CHECK(esp_codec_dev_open(adc, &input));
+    ESP_ERROR_CHECK(esp_codec_dev_open(dac, &output));
+    char layout[32] = {0};
+    ESP_ERROR_CHECK(esp_codec_dev_get_data_layout_label(adc, layout, sizeof(layout)));
+    ESP_LOGI(TAG, "Input layout=%s gain=18 dB; output volume=45", layout);
+    esp_capture_audio_src_if_t *aec = NULL;
+    int input_channels = 3;
+#if CONFIG_STACKCHAN_PROBE_AEC
+    ESP_ERROR_CHECK(esp_codec_dev_close(adc));
+    esp_capture_audio_aec_src_cfg_t cfg = {
+        .record_handle = adc, .mic_layout = "MRM", .channel = 4,
+        .channel_mask = 7, .data_on_vad = false,
+    };
+    aec = esp_capture_new_audio_aec_src(&cfg);
+    assert(aec);
+    ESP_ERROR_CHECK(aec->open(aec));
+    esp_capture_audio_info_t requested = {.format_id = ESP_CAPTURE_FMT_ID_PCM,
+        .sample_rate = RATE, .channel = 1, .bits_per_sample = 16};
+    esp_capture_audio_info_t negotiated = {0};
+    ESP_ERROR_CHECK(aec->negotiate_caps(aec, &requested, &negotiated));
+    ESP_ERROR_CHECK(aec->start(aec));
+    input_channels = 1;
+    ESP_LOGI(TAG, "AEC mono output; continuous capture; rms0 is processed PCM");
+#endif
+    finished = xSemaphoreCreateBinary();
+    assert(finished);
+    assert(xTaskCreate(writer, "probe_tx", 4096, NULL, 5, NULL) == pdPASS);
+    int16_t pcm[SAMPLES * 3];
+    uint64_t energy[3] = {0};
+    uint32_t rx_blocks = 0, rx_errors = 0, clips[3] = {0};
+    int64_t start = esp_timer_get_time();
+    for (int block = 0; block < BLOCKS; ++block) {
+        int err;
+        if (aec) {
+            esp_capture_stream_frame_t frame = {.data = (uint8_t *)pcm,
+                .size = SAMPLES * (int)sizeof(int16_t)};
+            err = aec->read_frame(aec, &frame);
+            if (frame.size != SAMPLES * sizeof(int16_t)) err = -1;
+        } else {
+            err = esp_codec_dev_read(adc, pcm, sizeof(pcm));
+        }
+        if (err) { ++rx_errors; break; }
+        ++rx_blocks;
+        for (int i = 0; i < SAMPLES; ++i) {
+            for (int c = 0; c < input_channels; ++c) {
+                int32_t v = pcm[i * input_channels + c];
+                energy[c] += (int64_t)v * v;
+                if (v >= 32760 || v <= -32760) ++clips[c];
+            }
+        }
+        if (rx_blocks % 50 == 0) {
+            uint32_t sent, errors;
+            portENTER_CRITICAL(&stats_lock);
+            sent = tx_blocks; errors = tx_errors;
+            portEXIT_CRITICAL(&stats_lock);
+            ESP_LOGI(TAG, "rx=%lu tx=%lu errors=%lu/%lu rms=%u,%u,%u clips=%lu,%lu,%lu elapsed_ms=%lld heap=%u",
+                     (unsigned long)rx_blocks, (unsigned long)sent,
+                     (unsigned long)rx_errors, (unsigned long)errors,
+                     (unsigned)sqrt((double)energy[0]/(50*SAMPLES)),
+                     (unsigned)sqrt((double)energy[1]/(50*SAMPLES)),
+                     (unsigned)sqrt((double)energy[2]/(50*SAMPLES)),
+                     (unsigned long)clips[0], (unsigned long)clips[1], (unsigned long)clips[2],
+                     (long long)(esp_timer_get_time()-start)/1000,
+                     (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL));
+            for (int c=0; c<3; ++c) { energy[c]=0; clips[c]=0; }
+        }
+    }
+    if (xSemaphoreTake(finished, pdMS_TO_TICKS(25000)) != pdTRUE) {
+        ESP_LOGE(TAG, "FAIL: playback stalled; codecs left open to avoid concurrent close");
+        return;
+    }
+    if (aec) {
+        ESP_ERROR_CHECK(aec->stop(aec));
+        ESP_ERROR_CHECK(aec->close(aec));
+        free(aec);
+    } else {
+        ESP_ERROR_CHECK(esp_codec_dev_close(adc));
+    }
+    ESP_ERROR_CHECK(esp_codec_dev_close(dac));
+    vSemaphoreDelete(finished);
+    ESP_LOGI(TAG, "DONE rx=%lu tx=%lu errors=%lu/%lu; inspect reference response before AEC",
+             (unsigned long)rx_blocks, (unsigned long)tx_blocks,
+             (unsigned long)rx_errors, (unsigned long)tx_errors);
+}
diff --git a/solutions/agora_demo/main/stackchan_touch.c b/solutions/agora_demo/main/stackchan_touch.c
new file mode 100644
index 0000000..8c1930a
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_touch.c
@@ -0,0 +1,179 @@
+/*
+ * Minimal whole-screen tap input for the verified StackChan/CoreS3 profile.
+ * Official M5Stack StackChan documentation identifies the FT6336U controller.
+ * The installed m5stack_boards 0.6.2 profile routes it through BoardManager's
+ * lcd_touch FT5x06-compatible factory on the existing i2c_master bus (0x38).
+ * Its reset/interrupt GPIOs are -1; the power dependency only deasserts the
+ * touch reset through the existing AW9523 handle, without pulsing audio rails.
+ * We deliberately do not create another bus, toggle GPIOs, or call M5.begin().
+ */
+#include "stackchan_touch.h"
+
+#include <stddef.h>
+#include "dev_lcd_touch.h"
+#include "esp_board_manager.h"
+#include "esp_lcd_touch.h"
+#include "esp_log.h"
+
+#define POLL_MS 20U
+#define MAX_POLL_GAP_MS 250U
+#define IDLE_ARM_MS 80U
+#define MIN_PRESS_MS 30U
+#define MAX_PRESS_MS 1200U
+#define RELEASE_DEBOUNCE_MS 40U
+#define TAP_COOLDOWN_MS 300U
+#define READ_RETRY_MS 1000U
+#define MAX_MOVEMENT_PX 28
+
+typedef enum {
+    WAIT_IDLE,
+    READY,
+    PRESSED,
+    RELEASING,
+} touch_state_t;
+
+static const char *TAG = "STACKCHAN_TOUCH";
+static esp_lcd_touch_handle_t touch;
+static bool attempted;
+static esp_err_t init_result = ESP_ERR_INVALID_STATE;
+static touch_state_t state;
+static bool idle_started;
+static bool polled;
+static bool error_reported;
+static bool cooldown;
+static uint32_t idle_since;
+static uint32_t pressed_since;
+static uint32_t released_since;
+static uint32_t last_poll;
+static uint32_t poll_interval = POLL_MS;
+static uint32_t last_error_log;
+static uint32_t last_tap;
+static uint16_t start_x;
+static uint16_t start_y;
+
+static void discard_gesture(void)
+{
+    state = WAIT_IDLE;
+    idle_started = false;
+}
+
+esp_err_t stackchan_touch_init(void)
+{
+    if (attempted) return init_result;
+    attempted = true;
+
+    init_result = esp_board_manager_init_device_by_name("lcd_touch");
+    if (init_result != ESP_OK) return init_result;
+
+    dev_lcd_touch_handles_t *handles = NULL;
+    init_result = esp_board_manager_get_device_handle("lcd_touch", (void **)&handles);
+    if (init_result == ESP_OK && (handles == NULL || handles->touch_handle == NULL)) {
+        init_result = ESP_ERR_INVALID_STATE;
+    }
+    if (init_result != ESP_OK) {
+        esp_err_t cleanup = esp_board_manager_deinit_device_by_name("lcd_touch");
+        if (cleanup != ESP_OK) ESP_LOGW(TAG, "Touch cleanup failed: %s", esp_err_to_name(cleanup));
+        return init_result;
+    }
+    touch = handles->touch_handle;
+    discard_gesture();
+    ESP_LOGI(TAG, "Whole-screen tap ready; release to arm, no input task");
+    return ESP_OK;
+}
+
+static bool read_failed(esp_err_t err, uint32_t now_ms)
+{
+    discard_gesture();
+    poll_interval = READ_RETRY_MS;
+    if (!error_reported || (uint32_t)(now_ms - last_error_log) >= 5000U) {
+        ESP_LOGW(TAG, "Touch read failed: %s; gesture discarded", esp_err_to_name(err));
+        last_error_log = now_ms;
+        error_reported = true;
+    }
+    return false;
+}
+
+bool stackchan_touch_take_tap(uint32_t now_ms)
+{
+    if (touch == NULL) return false;
+    if (polled && (uint32_t)(now_ms - last_poll) < poll_interval) return false;
+    if (polled && (uint32_t)(now_ms - last_poll) > MAX_POLL_GAP_MS) discard_gesture();
+    polled = true;
+    last_poll = now_ms;
+
+    esp_err_t err = esp_lcd_touch_read_data(touch);
+    if (err != ESP_OK) return read_failed(err, now_ms);
+    esp_lcd_touch_point_data_t points[2] = {0};
+    uint8_t count = 0;
+    err = esp_lcd_touch_get_data(touch, points, &count, 2);
+    if (err != ESP_OK) return read_failed(err, now_ms);
+    poll_interval = POLL_MS;
+    error_reported = false;
+
+    if (cooldown) {
+        if ((uint32_t)(now_ms - last_tap) < TAP_COOLDOWN_MS) {
+            discard_gesture();
+            return false;
+        }
+        cooldown = false;
+    }
+    if (count > 1) {
+        discard_gesture();
+        return false;
+    }
+
+    if (state == WAIT_IDLE) {
+        if (count != 0) {
+            idle_started = false;
+        } else if (!idle_started) {
+            idle_since = now_ms;
+            idle_started = true;
+        } else if ((uint32_t)(now_ms - idle_since) >= IDLE_ARM_MS) {
+            state = READY;
+        }
+        return false;
+    }
+    if (state == READY) {
+        if (count == 1) {
+            pressed_since = now_ms;
+            start_x = points[0].x;
+            start_y = points[0].y;
+            state = PRESSED;
+        }
+        return false;
+    }
+
+    uint32_t held_ms = now_ms - pressed_since;
+    if (held_ms > MAX_PRESS_MS) {
+        discard_gesture();
+        return false;
+    }
+    if (count == 1) {
+        int dx = (int)points[0].x - start_x;
+        int dy = (int)points[0].y - start_y;
+        if (dx > MAX_MOVEMENT_PX || dx < -MAX_MOVEMENT_PX ||
+            dy > MAX_MOVEMENT_PX || dy < -MAX_MOVEMENT_PX) {
+            discard_gesture();
+        } else {
+            state = PRESSED;
+        }
+        return false;
+    }
+    if (state == PRESSED) {
+        if (held_ms < MIN_PRESS_MS) {
+            discard_gesture();
+        } else {
+            state = RELEASING;
+            released_since = now_ms;
+        }
+        return false;
+    }
+    if ((uint32_t)(now_ms - released_since) >= RELEASE_DEBOUNCE_MS) {
+        discard_gesture();
+        last_tap = now_ms;
+        cooldown = true;
+        ESP_LOGI(TAG, "Screen tap released");
+        return true;
+    }
+    return false;
+}
diff --git a/solutions/agora_demo/main/stackchan_touch.h b/solutions/agora_demo/main/stackchan_touch.h
new file mode 100644
index 0000000..89a8cee
--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_touch.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "esp_err.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Call once after init_board(), from the same task that polls the screen.
+ * BoardManager owns the existing I2C bus, touch handle and power dependencies.
+ * This module creates no task and performs no hardware reset.
+ */
+esp_err_t stackchan_touch_init(void);
+
+/* Poll every 20–50 ms with a monotonic millisecond clock. Returns true once on
+ * release of a single-finger tap anywhere on the screen. A held startup touch,
+ * swipe, long hold, read error, or polling gap >250 ms cannot trigger a tap.
+ * All calls must use the same task; there is no event queue to replay later.
+ */
+bool stackchan_touch_take_tap(uint32_t now_ms);
+
+#ifdef __cplusplus
+}
+#endif
