--- /dev/null
+++ b/solutions/agora_demo/main/stackchan_human.c
@@ -0,0 +1,282 @@
+// HUMAN_ONLY PoC: no Bot Station, no Agent, no certificate signing.
+#include <stdbool.h>
+#include <string.h>
+#include <time.h>
+#include <sys/time.h>
+#include "common.h"
+#include "esp_capture.h"
+#include "esp_event.h"
+#include "esp_netif.h"
+#include "esp_wifi.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "esp_heap_caps.h"
+#include "nvs_flash.h"
+#include "nvs.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "media_lib_adapter.h"
+#include "media_lib_os.h"
+#include "webrtc_utils_time.h"
+#include "stackchan_session_local.h"
+#ifdef CONFIG_STACKCHAN_HEAD_MOTION
+#include "stackchan_motion.h"
+#endif
+#ifdef CONFIG_STACKCHAN_INTERACTIVE_AI
+#include "stackchan_touch.h"
+#include "stackchan_interaction.h"
+#endif
+#ifdef CONFIG_STACKCHAN_STATUS_SCREEN
+#include "status_screen.h"
+#define SHOW_STATUS(label) stackchan_status_show(label)
+#define TICK_STATUS() stackchan_status_tick((uint32_t)(esp_timer_get_time() / 1000))
+#else
+#define SHOW_STATUS(label) ((void)0)
+#define TICK_STATUS() ((void)0)
+#endif
+
+static const char *TAG = "STACKCHAN_HUMAN";
+static volatile bool online;
+bool network_is_connected(void) { return online; }
+
+static void thread_scheduler(const char *name, media_lib_thread_cfg_t *cfg)
+{
+    if (strcmp(name, "aenc_0") == 0) {
+        cfg->stack_size = 40 * 1024;
+        cfg->priority = 9;
+        cfg->core_id = 1;
+    } else if (strcmp(name, "AUD_SRC") == 0) {
+        cfg->stack_size = 16 * 1024;
+        cfg->priority = 10;
+        cfg->core_id = 1;
+    } else if (strcmp(name, "buffer_in") == 0) {
+        // Feed must outrank AFE fetch; otherwise fetch can starve its producer.
+        cfg->stack_size = 16 * 1024;
+        cfg->priority = 16;
+        cfg->core_id = 1;
+    } else if (strcmp(name, "Adec") == 0) {
+        cfg->stack_size = 40 * 1024;
+        cfg->priority = 12;
+        cfg->core_id = 0;
+    } else if (strcmp(name, "ARender") == 0) {
+        cfg->stack_size = 8 * 1024;
+        cfg->priority = 13;
+        cfg->core_id = 0;
+    } else if (strcmp(name, "pc_task") == 0) {
+        cfg->stack_size = 25 * 1024;
+        cfg->priority = 18;
+        cfg->core_id = 0;
+    }
+}
+
+static void capture_scheduler(const char *name,
+                              esp_capture_thread_schedule_cfg_t *cfg)
+{
+    media_lib_thread_cfg_t thread_cfg = {
+        .stack_size = cfg->stack_size,
+        .priority = cfg->priority,
+        .core_id = cfg->core_id,
+    };
+    // Reserve scarce internal RAM for the AEC feeder and Opus encoder. Moving
+    // every worker inside exhausted internal RAM while starting AUD_SRC.
+    cfg->stack_in_ext = strcmp(name, "aenc_0") != 0 && strcmp(name, "buffer_in") != 0;
+    thread_scheduler(name, &thread_cfg);
+    cfg->stack_size = thread_cfg.stack_size;
+    cfg->priority = thread_cfg.priority;
+    cfg->core_id = thread_cfg.core_id;
+}
+
+
+static void wifi_event(void *ctx, esp_event_base_t base, int32_t id, void *data)
+{
+    if (base == WIFI_EVENT && id == WIFI_EVENT_STA_START) esp_wifi_connect();
+    if (base == WIFI_EVENT && id == WIFI_EVENT_STA_DISCONNECTED) {
+        online = false;
+        const wifi_event_sta_disconnected_t *event = data;
+        ESP_LOGW(TAG, "Wi-Fi disconnected reason=%u", (unsigned)event->reason);
+        esp_wifi_connect();
+    }
+    if (base == IP_EVENT && id == IP_EVENT_STA_GOT_IP) {
+        online = true;
+        ESP_LOGI(TAG, "Wi-Fi ready");
+    }
+}
+
+static void connect_wifi(void)
+{
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+    wifi_init_config_t init = WIFI_INIT_CONFIG_DEFAULT();
+    init.nvs_enable = 0;
+    ESP_ERROR_CHECK(esp_wifi_init(&init));
+    ESP_ERROR_CHECK(esp_wifi_set_storage(WIFI_STORAGE_RAM));
+    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, wifi_event, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, wifi_event, NULL));
+    wifi_config_t cfg = {0};
+    strlcpy((char *)cfg.sta.ssid, STACKCHAN_WIFI_SSID, sizeof(cfg.sta.ssid));
+    strlcpy((char *)cfg.sta.password, STACKCHAN_WIFI_PASSWORD, sizeof(cfg.sta.password));
+    // Match the working whale's precedence; read saved user configuration only.
+    // Never erase NVS or fall back to an automatic reformat on init failure.
+#ifndef STACKCHAN_WIFI_OVERRIDE
+    if (nvs_flash_init() == ESP_OK) {
+        nvs_handle_t saved;
+        if (nvs_open("wifi", NVS_READONLY, &saved) == ESP_OK) {
+            char ssid[33] = {0}, password[65] = {0};
+            size_t ssid_size=sizeof(ssid), password_size=sizeof(password);
+            if (nvs_get_str(saved, "ssid", ssid, &ssid_size) == ESP_OK &&
+                nvs_get_str(saved, "password", password, &password_size) == ESP_OK && ssid[0]) {
+                strlcpy((char *)cfg.sta.ssid, ssid, sizeof(cfg.sta.ssid));
+                strlcpy((char *)cfg.sta.password, password, sizeof(cfg.sta.password));
+                ESP_LOGI(TAG, "Using saved whale Wi-Fi configuration");
+            }
+            nvs_close(saved);
+        }
+    }
+#endif
+    cfg.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &cfg));
+    ESP_ERROR_CHECK(esp_wifi_set_ps(WIFI_PS_NONE));
+    ESP_ERROR_CHECK(esp_wifi_start());
+}
+
+void app_main(void)
+{
+    vTaskDelay(pdMS_TO_TICKS(2000));
+#ifdef CONFIG_STACKCHAN_INTERACTIVE_AI
+    ESP_LOGI(TAG, "Official default avatar; touch start/stop AI; host-signed credentials");
+#else
+    ESP_LOGI(TAG, "HUMAN_ONLY; no Agent; credentials signed outside firmware");
+#endif
+    media_lib_add_default_adapter();
+    esp_capture_set_thread_scheduler(capture_scheduler);
+    media_lib_thread_set_schedule_cb(thread_scheduler);
+    if (init_board()) {
+        ESP_LOGE(TAG, "Board initialization failed"); return;
+    }
+#ifdef CONFIG_STACKCHAN_STATUS_SCREEN
+    if (stackchan_status_init() != 0) {
+        ESP_LOGW(TAG, "Status screen unavailable; continuing audio test");
+    }
+#endif
+    SHOW_STATUS("STARTING");
+    if (media_sys_buildup()) {
+        SHOW_STATUS("ERROR");
+        ESP_LOGE(TAG, "Media initialization failed"); return;
+    }
+#ifdef CONFIG_STACKCHAN_HEAD_MOTION
+    // Supply/expander setup is serialized before touch or interaction tasks.
+    // Motor discovery and smooth movement run asynchronously off audio core1.
+    if (stackchan_motion_init() != ESP_OK) {
+        ESP_LOGW(TAG, "Head motion unavailable; continuing without movement");
+    } else {
+        stackchan_motion_request(STACKCHAN_MOTION_REST);
+    }
+#endif
+    bool cloud_control = false;
+#ifdef CONFIG_STACKCHAN_INTERACTIVE_AI
+    cloud_control = strncmp(STACKCHAN_CONTROL_URL, "https://", 8) == 0;
+#endif
+    if (cloud_control) webrtc_set_uplink_enabled(false);
+    SHOW_STATUS("WIFI");
+    connect_wifi();
+    unsigned wifi_waits = 0;
+    while (!online && (cloud_control || wifi_waits < 300)) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+        TICK_STATUS();
+        ++wifi_waits;
+        if (cloud_control && !online && wifi_waits % 100 == 0) {
+            ESP_LOGW(TAG, "Waiting for Wi-Fi; cloud microphone remains idle");
+        }
+    }
+    if (!online) { SHOW_STATUS("ERROR"); ESP_LOGE(TAG, "Wi-Fi timeout"); return; }
+    if (cloud_control) {
+        // No controller/media session is started until a real SNTP response.
+        // Keep the face alive while Wi-Fi/SNTP retries; build time is only a
+        // LAN development fallback and cannot validate renewed cloud certs.
+        SHOW_STATUS("SYNCING TIME");
+        bool sntp_started = false;
+        int64_t next_notice = 0;
+        for (;;) {
+            if (online && !sntp_started) sntp_started = webrtc_utils_time_sync_init() == ESP_OK;
+            if (online && sntp_started && webrtc_utils_wait_for_time_sync(100) == ESP_OK &&
+                time(NULL) >= 1704067200) break;
+            TICK_STATUS();
+            if (esp_timer_get_time() >= next_notice) {
+                ESP_LOGW(TAG, "Waiting for network time; cloud microphone remains idle");
+                next_notice = esp_timer_get_time() + 10000000;
+            }
+            vTaskDelay(pdMS_TO_TICKS(100));
+        }
+    } else {
+        if (webrtc_utils_time_sync_init() != ESP_OK) return;
+        webrtc_utils_wait_for_time_sync(5000);
+    }
+    time_t now = time(NULL);
+#ifdef STACKCHAN_BUILD_UNIX_TIME
+    // Temporary bench-test fallback when UDP NTP is unavailable. The timestamp
+    // comes from this trusted development host; the WHIP server still enforces
+    // the signed JWT expiry against its own clock. Cloud time bootstrap remains
+    // a production requirement; do not ship long-lived builds with this alone.
+    if (!cloud_control && now < STACKCHAN_BUILD_UNIX_TIME) {
+        struct timeval tv = {.tv_sec = STACKCHAN_BUILD_UNIX_TIME + esp_timer_get_time()/1000000};
+        settimeofday(&tv, NULL);
+        now = time(NULL);
+        ESP_LOGW(TAG, "Using trusted build-time clock fallback for this short PoC");
+    }
+#endif
+    if (now < 1704067200
+#ifndef CONFIG_STACKCHAN_INTERACTIVE_AI
+        || now >= STACKCHAN_SESSION_EXPIRY
+#endif
+    ) {
+        SHOW_STATUS("ERROR");
+        ESP_LOGE(TAG, "Clock invalid or short-lived credential expired"); return;
+    }
+#ifdef CONFIG_STACKCHAN_INTERACTIVE_AI
+    if (stackchan_touch_init() != ESP_OK || stackchan_interaction_init() != 0) {
+        SHOW_STATUS("INPUT ERROR");
+        ESP_LOGE(TAG, "Interactive initialization failed; microphone remains idle");
+        return;
+    }
+    ESP_LOGI(TAG, "Touch ready; tap face to start or stop AI");
+    const int64_t test_deadline = CONFIG_STACKCHAN_INTERACTIVE_TEST_SECONDS == 0 ? INT64_MAX :
+        esp_timer_get_time() + (int64_t)CONFIG_STACKCHAN_INTERACTIVE_TEST_SECONDS * 1000000;
+    while (esp_timer_get_time() < test_deadline) {
+        uint32_t tick = (uint32_t)(esp_timer_get_time() / 1000);
+        if (stackchan_touch_take_tap(tick)) stackchan_interaction_tap();
+        SHOW_STATUS(stackchan_interaction_label());
+        TICK_STATUS();
+        vTaskDelay(pdMS_TO_TICKS(25));
+    }
+    stackchan_interaction_shutdown();
+    while (!stackchan_interaction_stopped()) vTaskDelay(pdMS_TO_TICKS(50));
+    SHOW_STATUS("ENDED");
+    ESP_LOGI(TAG, "PoC session closed; interactive bench finished");
+    return;
+#endif
+    SHOW_STATUS("CONNECTING");
+    if (start_webrtc(STACKCHAN_WHIP_URL, STACKCHAN_WHIP_TOKEN)) { SHOW_STATUS("ERROR"); return; }
+    ESP_LOGI(TAG, "Bounded call window: %d seconds", CONFIG_STACKCHAN_CALL_SECONDS);
+    const int64_t call_deadline = esp_timer_get_time() + (int64_t)CONFIG_STACKCHAN_CALL_SECONDS * 1000000;
+    int64_t next_query = esp_timer_get_time() + 5000000;
+    while (esp_timer_get_time() < call_deadline) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+        TICK_STATUS();
+        if (esp_timer_get_time() < next_query) continue;
+        next_query = esp_timer_get_time() + 5000000;
+        query_webrtc();
+        media_sys_query();
+        SHOW_STATUS(webrtc_is_connected() ? "READY" : "CONNECTING");
+        ESP_LOGI(TAG, "Internal heap free=%u minimum=%u largest=%u psram_free=%u",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+        if (!online || webrtc_needs_restart() || time(NULL) >= STACKCHAN_SESSION_EXPIRY) break;
+    }
+    stop_webrtc();
+    SHOW_STATUS("ENDED");
+    ESP_LOGI(TAG, "PoC session closed; no automatic Agent resume");
+}
