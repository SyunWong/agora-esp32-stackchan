+#include "sdkconfig.h"
+#include "status_screen.h"
+
+#if CONFIG_STACKCHAN_STATUS_SCREEN
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include "esp_attr.h"
+#include "esp_board_manager.h"
+#include "esp_board_manager_defs.h"
+#include "esp_board_manager_includes.h"
+#include "esp_heap_caps.h"
+#include "esp_lcd_ili9341.h"
+#include "esp_lcd_panel_io.h"
+#include "esp_lcd_panel_ops.h"
+#include "esp_log.h"
+#include "esp_random.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+
+#define WIDTH 320
+#define HEIGHT 240
+#define STRIP_LINES 2
+#define LABEL_MAX 26
+#define TRANSFER_TIMEOUT_MS 200
+#define EYE_SIZE 20
+#define EYE_TOP 94
+#define LABEL_TOP 196
+#define LABEL_HEIGHT 14
+
+static const char *TAG = "STATUS_SCREEN";
+static dev_display_lcd_handles_t *lcd;
+static uint16_t *strip;
+static DRAM_ATTR StaticSemaphore_t transfer_done_storage;
+static SemaphoreHandle_t transfer_done;
+static bool ready;
+static bool attempted;
+static bool scene_drawn;
+static bool eyes_closed;
+static bool blink_started;
+static uint32_t next_blink_ms;
+static char previous_label[LABEL_MAX + 1];
+
+_Static_assert(EYE_SIZE * EYE_SIZE <= WIDTH * STRIP_LINES, "Eye must fit DMA strip");
+
+// Physical unit identified by the original firmware:
+// DDh:00 CBh:14 ID4:1342 -> ILI9342C. Do not enable this module for an E panel.
+// The esp_lcd ILI9341 transport shares the required address-window operations;
+// supplying vendor_config replaces its incompatible default power/gamma table.
+static const ili9341_lcd_init_cmd_t panel_init[] = {
+    {0xc8, (const uint8_t[]){0xff, 0x93, 0x42}, 3, 0},
+    {0xc0, (const uint8_t[]){0x12, 0x12}, 2, 0},
+    {0xc1, (const uint8_t[]){0x03}, 1, 0},
+    {0xc5, (const uint8_t[]){0xf2}, 1, 0},
+    {0xb0, (const uint8_t[]){0xe0}, 1, 0},
+    {0xf6, (const uint8_t[]){0x01, 0x00, 0x00}, 3, 0},
+    {0xe0, (const uint8_t[]){0x00,0x0c,0x11,0x04,0x11,0x08,0x37,0x89,0x4c,0x06,0x0c,0x0a,0x2e,0x34,0x0f}, 15, 0},
+    {0xe1, (const uint8_t[]){0x00,0x0b,0x11,0x05,0x13,0x09,0x33,0x67,0x48,0x07,0x0e,0x0b,0x2e,0x33,0x0f}, 15, 0},
+    {0xb6, (const uint8_t[]){0x08,0x82,0x1d,0x04}, 4, 0},
+    {0x38, NULL, 0, 0},  // Idle mode off.
+    {0x29, NULL, 0, 0},  // Display on (preserves original sequence).
+    {0x11, NULL, 0, 120}, // Sleep out.
+};
+
+// Strong override of the official board package's weak factory. Board Manager
+// still creates/owns the SPI bus, panel IO, reset and AXP backlight path.
+esp_err_t lcd_panel_factory_entry_t(esp_lcd_panel_io_handle_t io,
+                                  const esp_lcd_panel_dev_config_t *config,
+                                  esp_lcd_panel_handle_t *out)
+{
+    static const ili9341_vendor_config_t vendor = {
+        .init_cmds = panel_init,
+        .init_cmds_size = sizeof(panel_init) / sizeof(panel_init[0]),
+    };
+    esp_lcd_panel_dev_config_t panel_config = *config;
+    panel_config.vendor_config = (void *)&vendor;
+    ESP_LOGI(TAG, "Using verified StackChan ILI9342C initialization");
+    return esp_lcd_new_panel_ili9341(io, &panel_config, out);
+}
+
+static bool IRAM_ATTR on_transfer_done(esp_lcd_panel_io_handle_t io,
+                                     esp_lcd_panel_io_event_data_t *event, void *ctx)
+{
+    (void)io;
+    (void)event;
+    BaseType_t wake = pdFALSE;
+    xSemaphoreGiveFromISR((SemaphoreHandle_t)ctx, &wake);
+    return wake == pdTRUE;
+}
+
+// Hand-defined 5x7 uppercase glyph rows; no external font runtime or assets.
+static const uint8_t font[26][7] = {
+    {14,17,17,31,17,17,17}, {30,17,17,30,17,17,30},
+    {14,17,16,16,16,17,14}, {30,17,17,17,17,17,30},
+    {31,16,16,30,16,16,31}, {31,16,16,30,16,16,16},
+    {14,17,16,23,17,17,14}, {17,17,17,31,17,17,17},
+    {14,4,4,4,4,4,14}, {7,2,2,2,2,18,12},
+    {17,18,20,24,20,18,17}, {16,16,16,16,16,16,31},
+    {17,27,21,21,17,17,17}, {17,25,21,19,17,17,17},
+    {14,17,17,17,17,17,14}, {30,17,17,30,16,16,16},
+    {14,17,17,17,21,18,13}, {30,17,17,30,20,18,17},
+    {15,16,16,14,1,1,30}, {31,4,4,4,4,4,4},
+    {17,17,17,17,17,17,14}, {17,17,17,17,17,10,4},
+    {17,17,17,21,21,21,10}, {17,17,10,4,10,17,17},
+    {17,17,10,4,4,4,4}, {31,1,2,4,8,16,31},
+};
+
+static bool text_pixel(const char *text, int top, int scale, int x, int y)
+{
+    if (y < top || y >= top + 7 * scale) return false;
+    int length = (int)strlen(text);
+    int left = (WIDTH - (length * 6 - 1) * scale) / 2;
+    if (x < left || x >= left + length * 6 * scale) return false;
+    int gx = (x - left) / scale;
+    int col = gx % 6;
+    unsigned char ch = (unsigned char)text[gx / 6];
+    if (col >= 5 || ch < 'A' || ch > 'Z') return false;
+    return (font[ch - 'A'][(y - top) / scale] & (1 << (4 - col))) != 0;
+}
+
+static uint16_t wire_color(uint16_t rgb565)
+{
+    // esp_lcd streams these bytes as-is: RGB565 needs most-significant byte first.
+    return (rgb565 << 8) | (rgb565 >> 8);
+}
+
+static uint16_t eye_pixel(int x, int y)
+{
+    // Upstream setSize(0) maps 8..32 to 20px. setWeight(25) moves a 20px
+    // black eyelid up 5px, covering the top 15 rows of the circle.
+    if (eyes_closed && y < 15) return 0;
+    unsigned covered = 0;
+    for (int sy = 0; sy < 4; ++sy) {
+        for (int sx = 0; sx < 4; ++sx) {
+            int dx = x * 8 + sx * 2 + 1 - 80;
+            int dy = y * 8 + sy * 2 + 1 - 80;
+            covered += dx * dx + dy * dy <= 80 * 80;
+        }
+    }
+    unsigned r = (covered * 31 + 8) / 16;
+    unsigned g = (covered * 63 + 8) / 16;
+    return (r << 11) | (g << 5) | r;
+}
+
+static uint16_t face_pixel(int x, int y)
+{
+    if (x >= 115 && x < 205 && y >= 143 && y < 149) return 0xffff;
+    if (y >= EYE_TOP && y < EYE_TOP + EYE_SIZE) {
+        if (x >= 80 && x < 100) return eye_pixel(x - 80, y - EYE_TOP);
+        if (x >= 220 && x < 240) return eye_pixel(x - 220, y - EYE_TOP);
+    }
+    return 0;
+}
+
+static bool submit_pixels(int left, int top, int width, int height)
+{
+    // Exactly one transfer at a time, so callback ownership is unambiguous.
+    esp_err_t err = esp_lcd_panel_draw_bitmap(lcd->panel_handle, left, top,
+                                             left + width, top + height, strip);
+    if (err != ESP_OK ||
+        xSemaphoreTake(transfer_done, pdMS_TO_TICKS(TRANSFER_TIMEOUT_MS)) != pdTRUE) {
+        ready = false;
+        // No free/reuse on error: a late DMA completion may still use strip.
+        ESP_LOGE(TAG, "LCD transfer failed (%s); updates disabled, DMA buffer retained",
+                 esp_err_to_name(err == ESP_OK ? ESP_ERR_TIMEOUT : err));
+        return false;
+    }
+    return true;
+}
+
+void stackchan_status_show(const char *label)
+{
+    if (!ready || label == NULL) return;
+    const char *visible = (strcmp(label, "READY") == 0 || strcmp(label, "RTC READY") == 0) ? "" : label;
+    char current[LABEL_MAX + 1];
+    size_t n = strnlen(visible, LABEL_MAX);
+    for (size_t i = 0; i < n; ++i) {
+        char ch = visible[i];
+        current[i] = (ch >= 'A' && ch <= 'Z') || ch == ' ' ? ch : ' ';
+    }
+    current[n] = '\0';
+    if (scene_drawn && strcmp(previous_label, current) == 0) return;
+
+    // Full screen is painted only once. Subsequent status changes touch the
+    // bottom label band; READY clears it to leave the original pure face.
+    int first = scene_drawn ? LABEL_TOP : 0;
+    int last = scene_drawn ? LABEL_TOP + LABEL_HEIGHT : HEIGHT;
+    for (int top = first; top < last; top += STRIP_LINES) {
+        for (int row = 0; row < STRIP_LINES; ++row) {
+            int y = top + row;
+            for (int x = 0; x < WIDTH; ++x) {
+                uint16_t color = face_pixel(x, y);
+                if (text_pixel(current, LABEL_TOP, 2, x, y)) color = 0x8c71;
+                strip[row * WIDTH + x] = wire_color(color);
+            }
+        }
+        if (!submit_pixels(0, top, WIDTH, STRIP_LINES)) return;
+    }
+    scene_drawn = true;
+    memcpy(previous_label, current, n + 1);
+    ESP_LOGI(TAG, "State: %s", label);
+}
+
+void stackchan_status_tick(uint32_t now_ms)
+{
+    if (!ready || !scene_drawn) return;
+    if (!blink_started) {
+        blink_started = true;
+        next_blink_ms = now_ms + 5200;
+        return;
+    }
+    // Signed modular subtraction also handles the millis counter wrapping.
+    if ((int32_t)(now_ms - next_blink_ms) < 0) return;
+    eyes_closed = !eyes_closed;
+    next_blink_ms = now_ms + (eyes_closed ? 200 : 5200 + esp_random() % 501);
+    for (int eye = 0; eye < 2; ++eye) {
+        for (int y = 0; y < EYE_SIZE; ++y) {
+            for (int x = 0; x < EYE_SIZE; ++x) {
+                strip[y * EYE_SIZE + x] = wire_color(eye_pixel(x, y));
+            }
+        }
+        // 20x20x2 = 800 bytes, one complete eye per transaction (two total).
+        if (!submit_pixels(eye == 0 ? 80 : 220, EYE_TOP, EYE_SIZE, EYE_SIZE)) return;
+    }
+}
+
+int stackchan_status_init(void)
+{
+    if (attempted) return ready ? ESP_OK : ESP_ERR_INVALID_STATE;
+    attempted = true;
+    strip = heap_caps_malloc(WIDTH * STRIP_LINES * sizeof(*strip),
+                             MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
+    if (strip == NULL) return ESP_ERR_NO_MEM;
+    transfer_done = xSemaphoreCreateBinaryStatic(&transfer_done_storage);
+    esp_err_t err = esp_board_device_init(ESP_BOARD_DEVICE_NAME_DISPLAY_LCD);
+    bool device_initialized = err == ESP_OK;
+    if (err == ESP_OK) {
+        err = esp_board_device_get_handle(ESP_BOARD_DEVICE_NAME_DISPLAY_LCD, (void **)&lcd);
+    }
+    if (err == ESP_OK && (lcd == NULL || lcd->panel_handle == NULL || lcd->io_handle == NULL)) {
+        err = ESP_ERR_INVALID_STATE;
+    }
+    if (err == ESP_OK) {
+        const esp_lcd_panel_io_callbacks_t callbacks = {.on_color_trans_done = on_transfer_done};
+        err = esp_lcd_panel_io_register_event_callbacks(lcd->io_handle, &callbacks, transfer_done);
+    }
+    if (err != ESP_OK) {
+        // No pixels were submitted, so freeing this buffer cannot race DMA.
+        if (device_initialized) {
+            esp_err_t cleanup = esp_board_device_deinit(ESP_BOARD_DEVICE_NAME_DISPLAY_LCD);
+            if (cleanup != ESP_OK) ESP_LOGW(TAG, "LCD cleanup failed: %s", esp_err_to_name(cleanup));
+        }
+        lcd = NULL;
+        heap_caps_free(strip);
+        strip = NULL;
+        ESP_LOGE(TAG, "LCD initialization failed: %s; continuing headless", esp_err_to_name(err));
+        return err;
+    }
+    ready = true;
+    stackchan_status_show("STARTING");
+    if (!ready) return ESP_FAIL;
+    ESP_LOGI(TAG, "ILI9342C 320x240, DMA strip=%u bytes; no display task",
+             (unsigned)(WIDTH * STRIP_LINES * sizeof(*strip)));
+    return ESP_OK;
+}
+#endif
