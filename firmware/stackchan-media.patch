+             (unsigned long)((now - raw_meter.started_us) / 1000),
+             (unsigned long)raw_meter.timeouts, (unsigned long)raw_meter.errors);
+    memset(&raw_meter, 0, sizeof(raw_meter));
+    raw_meter.started_us = now;
